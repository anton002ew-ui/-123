async def db_get_player_group(player_id):
    async with aiosqlite.connect(DB_PATH) as db:
        db.row_factory = aiosqlite.Row
        async with db.execute("""SELECT * FROM quest_groups
            WHERE status IN ('forming','active')""") as cur:
            all_groups = [dict(r) for r in await cur.fetchall()]
    for g in all_groups:
        members = json.loads(g['members'] or '[]')
        if player_id == g['leader_id'] or player_id in members:
            return g
    return None

async def db_create_quest_group(name, leader_id):
    try:
        async with aiosqlite.connect(DB_PATH) as db:
            cur = await db.execute("""INSERT INTO quest_groups
                (name, leader_id, members, status) VALUES (?, ?, ?, 'forming')""",
                (name, leader_id, json.dumps([leader_id])))
            await db.commit()
            return cur.lastrowid
    except Exception as e:
        print(f"[GROUP CREATE] {e}"); return None

