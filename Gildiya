class AddMemberSelectView(ui.View):
    def __init__(self, options, gid, qid, page, total_pages):
        super().__init__(timeout=300)
        self.gid = gid; self.qid = qid
        self.page = page; self.total_pages = total_pages
        if options:
            sel = ui.Select(placeholder="🎭 Кого добавить...", options=options[:25])
            sel.callback = self._on_pick; self.add_item(sel)
        if total_pages > 1:
            if page > 0:
                b = ui.Button(label="◀", style=discord.ButtonStyle.secondary, row=1)
                b.callback = self._prev; self.add_item(b)
            if page < total_pages - 1:
                b = ui.Button(label="▶", style=discord.ButtonStyle.secondary, row=1)
                b.callback = self._next; self.add_item(b)
    async def _on_pick(self, interaction):
        target_id = int(interaction.data['values'][0])
        g = await db_get_quest_group(self.gid)
        if not g: return
        if g['leader_id'] != interaction.user.id:
            await interaction.response.send_message("❌ Только лидер.", ephemeral=True); return
        members = json.loads(g['members'] or '[]')
        if len(members) >= MAX_GROUP_SIZE:
            await interaction.response.send_message(
                f"❌ Группа заполнена ({MAX_GROUP_SIZE}).", ephemeral=True); return
        if target_id in members:
            await interaction.response.send_message("❌ Уже в группе.", ephemeral=True); return
        tp = await db_get_player(target_id)
        if not tp or tp['is_alive'] == 0:
            await interaction.response.send_message("❌ Игрок недоступен.", ephemeral=True); return
        members.append(target_id)
        async with aiosqlite.connect(DB_PATH) as db:
            await db.execute("UPDATE quest_groups SET members=? WHERE id=?",
                             (json.dumps(members), self.gid))
            await db.commit()
        try:
            u = interaction.client.get_user(target_id)
            if u:
                await u.send(f"👥 Вас добавили в группу **{g['name']}**.\n"
                             f"Лидер: <@{g['leader_id']}>")
        except: pass
        new_opts, total_pages, page = await build_group_member_options(self.gid, self.page)
        await interaction.response.edit_message(
            content=f"✅ **{tp['name']}** добавлен ({len(members)}/{MAX_GROUP_SIZE})",
            embed=None, view=AddMemberSelectView(new_opts, self.gid, self.qid, page, total_pages))
    async def _prev(self, interaction):
        new_opts, total_pages, page = await build_group_member_options(self.gid, self.page - 1)
        await interaction.response.edit_message(
            view=AddMemberSelectView(new_opts, self.gid, self.qid, page, total_pages))
    async def _next(self, interaction):
        new_opts, total_pages, page = await build_group_member_options(self.gid, self.page + 1)
        await interaction.response.edit_message(
            view=AddMemberSelectView(new_opts, self.gid, self.qid, page, total_pages))


