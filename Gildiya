async def db_can_learn_profession(player_id, npc):
    p = await db_get_player(player_id)
    if not p: return False, "Нет персонажа"
    if p['is_alive'] == 0: return False, "Вы мертвы"
    prof = npc.get('profession')
    if not prof: return False, f"**{npc['name']}** не владеет профессией."
    if (npc.get('mastery') or 0) <= 0 or npc['level'] < MASTER_MIN_LEVEL:
        return False, f"**{npc['name']}** не мастер."
    profs = json.loads(p['professions'] or '[]')
    if prof in profs or p['profession'] == prof: return False, f"Уже знаете **{prof}**."
    bonus = p['bonus_profession_slots'] or 0
    if len(profs) >= MAX_PROFESSIONS + bonus: return False, "Нет слотов."
    if p['level'] < STUDENT_MIN_LEVEL: return False, f"Нужен ур.{STUDENT_MIN_LEVEL}+"
    async with aiosqlite.connect(DB_PATH) as db:
        db.row_factory = aiosqlite.Row
        async with db.execute("""SELECT taught_at FROM profession_teachers WHERE player_id=?
                                ORDER BY taught_at DESC LIMIT 1""", (player_id,)) as cur:
            r = await cur.fetchone()
    if r and r['taught_at']:
        try:
            last = datetime.fromisoformat(r['taught_at'])
            left = (datetime.utcnow() - last).days
            if left < LEARN_COOLDOWN_DAYS:
                return False, f"Следующее через {LEARN_COOLDOWN_DAYS-left} дн."
        except: pass
    return True, prof


