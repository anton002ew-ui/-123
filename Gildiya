async def handle_gameplay_thread_message(message):
    t = await db_get_gameplay_thread(message.channel.id)
    if not t: return
    parts_list = json.loads(t['participants'] or '[]')
    if message.author.id not in parts_list:
        await message.reply("❌ Не участник."); return
    p = await db_get_player(message.author.id)
    if not p or p['is_alive'] == 0:
        await message.reply("💀 Мёртвые не действуют."); return

    await touch_player_action(message.author.id)
    p = await db_get_player(message.author.id)

    in_jail, minutes_left = await check_jail(p)
    if in_jail:
        await message.reply(embed=discord.Embed(
            title="🔒 Ты в тюрьме",
            description=(f"*Стены холодные, решётка крепкая.*\n\n"
                         f"⏱️ До освобождения: **{minutes_left} мин.**\n"
                         f"💰 Залог: `/bail`"),
            color=EMBED_COLORS["shadow"]))
        return

    if p.get('is_sleeping') == 1:
        await message.reply("😴 Ты спишь. Нажми **☀️ Проснуться**."); return

    if p.get('is_abandoned_spirit') == 1:
        await message.reply("🌫️ Ты брошенный дух. Доступно только: `/possess`, `/map`, `/my_level`.")
        return

    sess = await db_get_dungeon_session(message.channel.id)
    if sess and sess['room'] == 3:
        text = message.content.lower()
        if "сундук" in text or "открыть" in text:
            state = json.loads(sess['room_state'] or '{}')
            if not state.get("chest_opened"):
                state["chest_opened"] = True
                await db_update_dungeon_session(message.channel.id, room_state=state)
                await message.channel.send("📦 Сундук открыт!")
                await asyncio.sleep(2)
                async with aiosqlite.connect(DB_PATH) as db:
                    db.row_factory = aiosqlite.Row
                    async with db.execute("SELECT * FROM dungeons WHERE id=?",
                                         (sess['dungeon_id'],)) as cur:
                        r = await cur.fetchone(); dng = dict(r) if r else None
                if dng:
                    dng['biome'] = dng.get('biome', 'plains')
                    await db_update_dungeon_session(message.channel.id, room=4, room_state={})
                    await enter_dungeon_room(message.channel, dng, 4, p)
                return

    new_loc = p.get('location') or "—"; new_inc = p.get('in_city', 1)
    if new_loc != t['location'] or new_inc != t['in_city']:
        await db_save_gameplay_thread(t['thread_id'], t['owner_id'], parts_list,
            is_battle=t['is_battle'], enemy_name=t['enemy_name'],
            enemy_stats=json.loads(t['enemy_stats'] or '{}'),
            enemy_hp=t['enemy_hp'], enemy_max_hp=t['enemy_max_hp'],
            enemy_level=t['enemy_level'],
            location=new_loc, in_city=new_inc, story_summary=t['story_summary'] or "")

    async with message.channel.typing():
        difficulty = await ai_evaluate_difficulty(p, message.content)
        if t['is_battle']: difficulty = min(5, difficulty + 1)
    spec = DIFFICULTY_TABLE.get(difficulty, DIFFICULTY_TABLE[3])
    bi = (f"\n⚔️ Бой: **{t['enemy_name']}** HP {t['enemy_hp']}/{t['enemy_max_hp']}"
          if t['is_battle'] else "")
    embed = discord.Embed(title=f"🎲 {spec['name']} ({spec['dice']}, нужно {spec['target']}+)",
        description=f"Действие: *{message.content[:180]}*{bi}", color=0x3182ce)
    await message.reply(embed=embed,
        view=DiceView(message.channel.id, spec, message.content, message.author.id))
    try: await refresh_player_panel(message.channel, message.author.id)
    except: pass


