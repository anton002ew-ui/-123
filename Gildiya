async def npc_movement_tick():
    await bot.wait_until_ready()
    if not await db_is_bot_running(): return
    cutoff = (datetime.utcnow() - timedelta(days=10)).isoformat()
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("""UPDATE npcs SET status='in_city',
            home_settlement=COALESCE(target_settlement, home_settlement),
            x=COALESCE(target_x, x), y=COALESCE(target_y, y),
            target_settlement=NULL, target_x=NULL, target_y=NULL, traveling_since=NULL
            WHERE status='traveling' AND traveling_since IS NOT NULL AND traveling_since < ?""",
            (cutoff,))
        await db.commit()
        db.row_factory = aiosqlite.Row
        async with db.execute("SELECT * FROM npcs WHERE status='traveling'") as cur:
            travelers = [dict(r) for r in await cur.fetchall()]
    for npc in travelers:
        tx = npc.get('target_x') or npc['x']; ty = npc.get('target_y') or npc['y']
        dx = tx - npc['x']; dy = ty - npc['y']; d = (dx*dx+dy*dy) ** 0.5
        if d < 3:
            async with aiosqlite.connect(DB_PATH) as db:
                await db.execute("""UPDATE npcs SET status='in_city',
                    home_settlement=?,x=?,y=?,target_settlement=NULL,
                    target_x=NULL,target_y=NULL,traveling_since=NULL WHERE id=?""",
                    (npc['target_settlement'], tx, ty, npc['id']))
                await db.commit()
        else:
            step = min(3, d)
            nx = int(npc['x'] + dx/d*step); ny = int(npc['y'] + dy/d*step)
            async with aiosqlite.connect(DB_PATH) as db:
                await db.execute("UPDATE npcs SET x=?, y=? WHERE id=?", (nx, ny, npc['id']))
                await db.commit()


