        sel = ui.Select(placeholder="🍖 Что съесть...", options=opts[:25])
        sel.callback = self._on_pick; self.add_item(sel)
    async def _on_pick(self, interaction):
        if interaction.user.id != self.pid: return
        inv_id = int(interaction.data['values'][0])
        p = await db_get_player(self.pid)
        if not p: return
        async with aiosqlite.connect(DB_PATH) as db:
            db.row_factory = aiosqlite.Row
            async with db.execute("SELECT * FROM inventory WHERE id=?", (inv_id,)) as cur:
                inv = await cur.fetchone()
        if not inv: return
        inv = dict(inv); iid = inv['item_id']
        it = ITEMS.get(iid, {})
        if it.get('cat') != "food":
            await interaction.response.send_message("❌ Не еда.", ephemeral=True); return
        rolled = json.loads(inv.get('rolled_stats') or '{}')
        bonus_hp = rolled.get('food_hp', it.get('heal_hp', 0))
        bonus_mag = rolled.get('food_mag', it.get('heal_mag', 0))
        nh = min(p['max_hunger'], p['hunger'] + it.get('hunger', 0))
        nt = min(p['max_thirst'], p['thirst'] + it.get('thirst', 0))
        new_hp = min(p['max_hp'], p['hp'] + bonus_hp)
        if bonus_mag > 0:
            await add_active_effect(p, f"food_mag_{iid}", 1800,
                                    {"mag": bonus_mag, "atk_flat": bonus_mag // 2})
        await db_save_player({**p, "hunger": nh, "thirst": nt, "hp": new_hp})
        await remove_inventory_item(self.pid, iid, 1, inv['quality'])
        msg = f"🍖 {iid}\nГолод: {nh:.0f}"
        if bonus_hp: msg += f"\n❤️ +{bonus_hp} HP → {new_hp}/{p['max_hp']}"
        if bonus_mag: msg += f"\n✨ +{bonus_mag} MAG (30 мин)"
        await interaction.response.send_message(msg, ephemeral=True)


