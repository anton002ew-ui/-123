        async with aiosqlite.connect(DB_PATH) as db:
            db.row_factory = aiosqlite.Row
            async with db.execute("""SELECT * FROM npcs
                WHERE status='in_city' AND role IN ('adventurer','guard','priest','citizen')
                ORDER BY RANDOM() LIMIT 1""") as cur:
