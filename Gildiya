async def trim_quest_board():
    async with aiosqlite.connect(DB_PATH) as db:
        db.row_factory = aiosqlite.Row
        async with db.execute("""SELECT id FROM quest_board WHERE status='open'
                                ORDER BY id DESC LIMIT -1 OFFSET ?""",
                             (MAX_QUEST_BOARD,)) as cur:
            excess = [r['id'] for r in await cur.fetchall()]
        for qid in excess:
            await db.execute("UPDATE quest_board SET status='expired' WHERE id=?", (qid,))
            await db.execute("DELETE FROM quest_groups WHERE quest_id=?", (qid,))
        cutoff = (datetime.utcnow() - timedelta(days=3)).isoformat()
        await db.execute("""DELETE FROM quest_board
            WHERE status IN ('done','failed','expired') AND created_at < ?""", (cutoff,))
        await db.commit()
    if excess: print(f"[QUESTS] Закрыто лишних: {len(excess)}")


async def ensure_quest_board_filled():
