                    await db_save_gameplay_thread(tid, t['owner_id'],
                        json.loads(t['participants'] or '[]'), is_battle=0, location=dng['name'],
                        in_city=0, story_summary="Босс побеждён")
                    e = build_victory_embed(t['enemy_name'], rl,
                        [f"🕳️ {dng['name']} рушится."], is_boss=True)
                    await interaction.channel.send(embed=e)
                    try: await interaction.channel.edit(archived=True, locked=True)
                    except: pass
                    return
                nr = cr + 1
                await db_update_dungeon_session(tid, room=nr, room_state={})
                await db_save_gameplay_thread(tid, t['owner_id'],
                    json.loads(t['participants'] or '[]'), is_battle=0, location=dng['name'],
                    in_city=0, story_summary=f"Комната {cr} зачищена")
                await interaction.channel.send(embed=discord.Embed(
                    title=f"✅ Комната {cr} зачищена!",
                    description=("\n".join(rl) or "—") + f"\n🚪 → Комната {nr}/4...",
                    color=0x48bb78))
                await asyncio.sleep(2)
                owner = await db_get_player(t['owner_id'])
                await enter_dungeon_room(interaction.channel, dng, nr, owner)
                return

            # ОБЫЧНЫЙ БОЙ
            else:
                await db_save_gameplay_thread(tid, t['owner_id'], parts, is_battle=0,
                    location=t['location'], in_city=t['in_city'], story_summary=t['story_summary'] or "")
                await interaction.channel.send(embed=build_victory_embed(
                    t['enemy_name'], rl, []))
                try:
                    for c in contribs_snapshot:
                        await db_add_contribution(tid, c['discord_id'],
