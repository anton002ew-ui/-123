async def handle_steal(interaction, target_name="кого-то"):
    p = await db_get_player(interaction.user.id)
    if not p: return
    blocked, msg = await is_blocked_action(p, "воровать")
    if blocked:
        await interaction.response.send_message(msg, ephemeral=True); return

    async with aiosqlite.connect(DB_PATH) as db:
        db.row_factory = aiosqlite.Row
        async with db.execute("""SELECT created_at FROM crimes
            WHERE player_id=? ORDER BY id DESC LIMIT 1""", (interaction.user.id,)) as cur:
            last = await cur.fetchone()
    if last and last['created_at']:
        try:
            delta = (datetime.utcnow() - datetime.fromisoformat(last['created_at'])).total_seconds() / 60
            if delta < STEAL_COOLDOWN_MIN:
                left = int(STEAL_COOLDOWN_MIN - delta)
                await interaction.response.send_message(
                    f"⏱️ Слишком скоро после прошлой кражи ({left} мин).", ephemeral=True)
                return
        except: pass

    city = p.get('location') or ""
    async with aiosqlite.connect(DB_PATH) as db:
        db.row_factory = aiosqlite.Row
        async with db.execute("""SELECT * FROM npcs
            WHERE home_settlement=? AND status='in_city'
            AND role IN ('citizen','merchant','craftsman')
            ORDER BY RANDOM() LIMIT 1""", (city,)) as cur:
            target = await cur.fetchone()
    if not target:
        await interaction.response.send_message("❌ Некого обокрасть.", ephemeral=True); return
    target = dict(target)

    await interaction.response.defer()

    context = (f"Игрок {p['name']} ({p['race']}, ур.{p['level']}) "
               f"в городе {city} пытается украсть у {target['name']} "
               f"({NPC_ROLES.get(target['role'],{}).get('name','житель')}, ур.{target['level']}).")
    crime_eval = await ai_evaluate_crime(context)
    difficulty = crime_eval.get('difficulty', 3)
    severity = crime_eval.get('severity', 1)
    witnesses = crime_eval.get('witnesses', 1)
    stolen_value = crime_eval.get('stolen_value', 20)

    spec = DIFFICULTY_TABLE.get(difficulty, DIFFICULTY_TABLE[3])
    intl_bonus = p['intl'] // 3
    res, _, _ = await animate_dice_roll(
        interaction.channel, int(spec['dice'][1:]),
        prefix="Кража", target=spec['target'], bonus=intl_bonus)
    ok = (res + intl_bonus) >= spec['target']

    caught_by_witness = False
    if ok and witnesses > 0:
        witness_roll = random.random()
        if witness_roll < WITNESS_CHANCE_BASE + witnesses * 0.15:
            caught_by_witness = True

    if ok:
        gold_stolen = max(5, stolen_value) if random.random() < 0.7 else 0
        items_stolen = []
        if random.random() < 0.5:
            pool = monster_loot_pool("Гоблин", get_biome_at(target['x'], target['y']))
            if pool:
                iid = random.choice(pool)
                await add_inventory_item(interaction.user.id, iid, 1, 1)
                items_stolen.append(iid)
        if gold_stolen:
            await give_gold(interaction.user.id, gold_stolen, f"кража у {target['name']}")

        embed = discord.Embed(
            title="🥷 Кража удалась!",
            description=(
                f"Ты тихо обчистил **{target['name']}**.\n\n"
                + (f"💰 Украдено: **{gold_stolen}** золота\n" if gold_stolen else "")
                + (f"📦 Предметы: {', '.join(items_stolen)}\n" if items_stolen else "")),
            color=EMBED_COLORS["warning"])
        embed.add_field(name="🎲 Бросок",
                        value=f"{spec['dice']}={res}+{intl_bonus} ≥ {spec['target']}", inline=True)
        await interaction.channel.send(embed=embed)

        await _register_crime(interaction.user.id, city, "steal",
                              f"Кража у {target['name']}", severity, 0, gold_stolen, False)
        if caught_by_witness:
            await _report_crime_to_guards(interaction.user.id, city, target['name'],
                                          severity, interaction.channel)
    else:
        embed = discord.Embed(
            title="🚨 Тебя заметили!",
            description=(f"Ты пытался обокрасть **{target['name']}**, но тебя схватили!\n\n"
                         f"Крики о помощи уже слышны по всей улице..."),
            color=EMBED_COLORS["danger"])
        embed.add_field(name="🎲 Бросок",
                        value=f"{spec['dice']}={res}+{intl_bonus} < {spec['target']}", inline=True)
        await interaction.channel.send(embed=embed)
        await _register_crime(interaction.user.id, city, "steal_fail",
                              f"Неудачная кража у {target['name']}", severity, 0, 0, False)
        await _report_crime_to_guards(interaction.user.id, city, target['name'],
                                      severity, interaction.channel, caught_in_act=True)


async def _register_crime(player_id, city, kind, description, severity,
                           witnesses, stolen_value, reported):
