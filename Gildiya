MAP_FILE = os.path.join(PHOTO_DIR, "map.png")
MAP_BOUNDS = (0.030, 0.025, 0.845, 0.965)

def draw_player_on_map(px, py, dungeons=None, temples=None, marker=(220,20,20)):
    try:
        if not os.path.exists(MAP_FILE): return None
        img = Image.open(MAP_FILE).convert("RGBA")
        w, h = img.size; l, t, r, b = MAP_BOUNDS
        def to_px(x, y):
            xp = int(w * (l + (r-l)*(x/200.0))); yp = int(h * (t + (b-t)*(y/200.0)))
            return max(15, min(w-15, xp)), max(15, min(h-15, yp))
        draw = ImageDraw.Draw(img, "RGBA")
        if dungeons:
            for d in dungeons:
                dx, dy = to_px(d['x'], d['y'])
                draw.ellipse([dx-12,dy-12,dx+12,dy+12], fill=(40,20,20,230),
                             outline=(255,200,100,255), width=2)
                draw.polygon([(dx-7,dy+6),(dx+7,dy+6),(dx,dy-8)], fill=(255,200,100,255))
        if temples:
            for tm in temples:
                tx, ty = to_px(tm['x'], tm['y'])
                draw.ellipse([tx-11,ty-11,tx+11,ty+11], fill=(250,240,200,230),
                             outline=(120,80,40,255), width=2)
                draw.line([(tx,ty-6),(tx,ty+6)], fill=(160,60,60,255), width=3)
                draw.line([(tx-5,ty-1),(tx+5,ty-1)], fill=(160,60,60,255), width=3)
        x_px, y_px = to_px(px, py)
        for rr, alpha in [(28,35),(20,60),(14,100)]:
            draw.ellipse([x_px-rr,y_px-rr//3,x_px+rr,y_px+rr//3], fill=(*marker, alpha))
        cx, cy = x_px, y_px
        bc = (30,30,30,255); oc = (255,255,255,255)
        hr = 8; hcy = cy-30; bt = hcy+hr+1; bb = cy+8; ay = bt+8; aw = 12; lw = 10; lwd = 4
        def line(a, b_, wd=lwd):
            draw.line([a,b_], fill=oc, width=wd+3); draw.line([a,b_], fill=bc, width=wd)
        draw.ellipse([cx-hr-2,hcy-hr-2,cx+hr+2,hcy+hr+2], fill=oc)
        draw.ellipse([cx-hr,hcy-hr,cx+hr,hcy+hr], fill=bc)
        line((cx,bt),(cx,bb)); line((cx,ay),(cx-aw,ay-8)); line((cx,ay),(cx+aw,ay-8))
        line((cx,bb),(cx-lw,bb+14)); line((cx,bb),(cx+lw,bb+14))
        try: font = ImageFont.truetype("arial.ttf", 22)
        except:
            try: font = ImageFont.truetype("DejaVuSans-Bold.ttf", 22)
            except: font = ImageFont.load_default()
        text = "ВЫ ЗДЕСЬ"
        bbox = draw.textbbox((0,0), text, font=font); tw = bbox[2]-bbox[0]; th = bbox[3]-bbox[1]
        tx = cx-tw//2; ty = hcy-hr-30
        draw.rectangle([tx-10,ty-6,tx+tw+10,ty+th+6], fill=(0,0,0,210),
                       outline=(255,255,255,255), width=2)
        draw.text((tx,ty), text, fill=(255,255,255,255), font=font)
        buf = io.BytesIO(); img.save(buf, format="PNG", optimize=True); buf.seek(0)
        return buf
    except Exception as e:
        print(f"[MAP ERR] {e}"); return None


async def send_player_map(interaction):
    p = await db_get_player(interaction.user.id)
    if not p:
        await interaction.response.send_message("❌ Нет персонажа.", ephemeral=True); return
    px = p.get('player_x',100) or 100; py = p.get('player_y',100) or 100
    loc = p.get('location') or "—"; inc = p.get('in_city',1)
    dungeons = await db_get_active_dungeons(); temples = await db_get_all_wild_temples()
    nearby = []
    for cn,(cx,cy) in CITY_COORDS.items():
        d = ((cx-px)**2+(cy-py)**2) ** 0.5
        if d <= 60: nearby.append((d,cn,cx,cy))
    nearby.sort(key=lambda x: x[0])
    buf = draw_player_on_map(px, py, dungeons=dungeons, temples=temples)
    if buf is None:
        await interaction.response.send_message(f"⚠️ map.png не найден.\nX={px:.0f}, Y={py:.0f}",
                                                ephemeral=True); return
    desc = (f"**📍 {loc}**\n**🧍 X={px:.0f}, Y={py:.0f}**\n"
            f"**🏘 {'в городе' if inc else 'в дикой'}**\n"
            f"**🕳️ {len(dungeons)} · ⛪ {len(temples)}**\n")
    if nearby:
        desc += "\n**🎯 Ближайшие города:**\n"
        for d,n,cx,cy in nearby[:5]:
            m = " ← вы" if n == loc else ""
            desc += f"• **{n}** ({cx},{cy}) — {d:.0f} кл.{m}\n"
    embed = discord.Embed(title="🗺️ Карта мира", description=desc, color=0x8b5a2b)
    embed.set_footer(text="🔴 Вы · 🟡 Подземелья · ⛪ Храмы")
    f = discord.File(buf, filename="map_with_you.png")
    embed.set_image(url="attachment://map_with_you.png")
    await interaction.response.send_message(embed=embed, file=f, ephemeral=True)


