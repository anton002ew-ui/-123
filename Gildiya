async def ensure_dungeons_count(target=15):
    now = datetime.utcnow().isoformat()
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("DELETE FROM dungeons WHERE respawn_at IS NOT NULL AND respawn_at < ?", (now,))
        await db.commit()
        async with db.execute("SELECT COUNT(*) FROM dungeons") as cur:
            cnt = (await cur.fetchone())[0]
    while cnt > target:
        async with aiosqlite.connect(DB_PATH) as db:
            db.row_factory = aiosqlite.Row
            async with db.execute("SELECT id FROM dungeons ORDER BY id LIMIT 1") as cur:
                r = await cur.fetchone()
            if not r: break
            await db.execute("DELETE FROM dungeons WHERE id=?", (r['id'],)); await db.commit()
        cnt -= 1
    while cnt < target:
        r = await db_add_random_dungeon()
        if not r: break
        cnt += 1
    return cnt

