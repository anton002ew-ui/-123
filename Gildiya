async def add_active_effect(row, key, dur, data):
    p = dict(row); eff = parse_active_effects(p)
    until = (datetime.utcnow() + timedelta(seconds=dur)).isoformat()
    eff[key] = {"until":until,"data":data}
    await db_save_player({**p, "active_effects":json.dumps(eff)}); return eff

async def cleanup_expired_effects(row):
    p = dict(row); eff = parse_active_effects(p); now = datetime.utcnow(); rm = []
    for k in list(eff.keys()):
        try:
            if datetime.fromisoformat(eff[k]['until']) < now: rm.append(k); del eff[k]
        except: del eff[k]
    if rm: await db_save_player({**p, "active_effects":json.dumps(eff)})
    return rm

def get_ability_bonus(row):
    eff = parse_active_effects(row)
    b = {"atk_mult":1.0,"def_mult":1.0,"atk_flat":0,"spd_mod":0,"intl_mod":0,"dodge":0,
         "see_hidden":0,"detection":0,"ignore_death":0,"invisible":0,"stealth":0,
         "heal_percent":0,"necro_damage":0,"aoe_damage":0,"craft_bonus":0,"regen_bonus":0}
    for k,v in eff.items():
        for bk,bv in v.get('data',{}).items():
            if bk in b:
                if bk.endswith("_mult"): b[bk] *= bv
                else: b[bk] += bv
    return b

def total_profession_bonuses(p):
    plv = json.loads(p.get('profession_level') or '{}')
    total = {"craft_bonus":0,"gold_bonus":0,"atk_bonus":0,"hp_bonus":0,
             "heal_bonus":0,"crit_bonus":0,"rep_bonus":0,"gather_bonus":0}
    for prof, lv in plv.items():
        b = profession_bonus_at_level(prof, lv)
        for k, v in b.items():
            total[k] = total.get(k, 0) + v
    return total

async def add_profession_xp(player_id, prof, amount):
    p = await db_get_player(player_id)
    if not p or prof not in PROFESSIONS: return None, 0
    pxp = json.loads(p.get('profession_xp') or '{}')
    plv = json.loads(p.get('profession_level') or '{}')
    cur_xp = pxp.get(prof, 0); cur_lv = plv.get(prof, 0)
    if cur_lv >= MAX_PROFESSION_LEVEL: return cur_lv, 0
    cur_xp += amount; gained = 0
    while cur_lv < MAX_PROFESSION_LEVEL:
        need = prof_xp_for_next(cur_lv)
        if not need or cur_xp < need: break
        cur_xp -= need; cur_lv += 1; gained += 1
    pxp[prof] = cur_xp; plv[prof] = cur_lv
    await db_save_player({**p, "profession_xp":json.dumps(pxp),
                          "profession_level":json.dumps(plv)})
    if gained > 0:
        await db_log_event(f"🎓 **{p['name']}** повысил **{prof}** до ур. **{cur_lv}**!")
    return cur_lv, gained


