async def ai_evaluate_difficulty(player, action):
    prompt = (f"Оцени сложность действия для RPG. Верни ТОЛЬКО JSON.\n"
              f"Персонаж: {player['name']}, {player['race']}, ур.{player['level']}.\n"
              f"Действие: {action}\n{{\"difficulty\": 3}}\n"
              f"1=тривиально, 2=легко, 3=средне, 4=сложно, 5=почти невозможно.")
    headers = {"Authorization": f"Bearer {API_KEY_TEXT}", "Content-Type": "application/json"}
    payload = {"model": TEXT_MODEL, "messages": [{"role":"user","content":prompt}], "max_tokens": 80}
    try:
        async with aiohttp.ClientSession() as s:
            async with s.post(TEXT_API_URL, json=payload, headers=headers, timeout=45) as r:
                if r.status != 200: return 3
                data = await r.json()
                txt = data['choices'][0]['message']['content']
                a = txt.find('{'); b = txt.rfind('}')
                if a >= 0 and b > a:
                    return max(1, min(5, int(json.loads(txt[a:b+1]).get('difficulty', 3))))
    except: pass
    return 3


