    if not p: return
    now = datetime.utcnow().isoformat()
    if afk:
        await db_save_player({**p, "is_afk":1, "afk_since":now, "last_action_at":now})
    else:
        await db_save_player({**p, "is_afk":0, "afk_since":None, "last_action_at":now})

def is_player_afk_check(p):
    if not p: return False
    if p.get('is_afk') == 1: return True
    last = p.get('last_action_at')
    if not last: return False
    try:
        delta = (datetime.utcnow() - datetime.fromisoformat(last)).total_seconds() / 60
        return delta >= AFK_TIMEOUT_MIN
    except: return False

async def mark_idle_players_afk():
    players = await db_get_all_alive_players()
    count = 0
    for p in players:
        if p.get('is_afk') == 1: continue
        if is_player_afk_check(p):
            await db_save_player({**p, "is_afk":1,
                                  "afk_since":datetime.utcnow().isoformat()})
            count += 1
    if count: print(f"[AFK] Помечено АФК: {count}")
    return count


