         (tp.get('player_y', 100) - p.get('player_y', 100)) ** 2) ** 0.5
    if d > 5:
        await interaction.response.send_message(f"❌ Далеко ({d:.0f} кл.). Нужно ≤5.", ephemeral=True); return

    await interaction.response.defer()
    prof_b = total_profession_bonuses(p)
