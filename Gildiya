class AppearanceView(ui.View):
    def __init__(self, uid, race, gender, element=None, mode="player", data=None):
        super().__init__(timeout=600)
        self.uid = uid; self.race = race; self.gender = gender
        self.element = element; self.mode = mode; self.data = dict(data) if data else {}
        for i, key in enumerate(["age","build","hair"]):
            opts = [discord.SelectOption(label=o[:100], value=o[:100]) for o in APPEARANCE_OPTIONS[key]]
            sel = ui.Select(placeholder=APPEARANCE_LABELS[key], options=opts, row=i)
            sel.callback = self._make_cb(key); self.add_item(sel)
        nb = ui.Button(label="Далее →", style=discord.ButtonStyle.success, row=3)
        nb.callback = self._on_next; self.add_item(nb)
    def _make_cb(self, key):
        async def cb(interaction):
            if interaction.user.id != self.uid:
                await interaction.response.defer(); return
            self.data[key] = interaction.data['values'][0]
            try: await interaction.response.edit_message(embed=self._embed(), view=self)
            except: await interaction.response.defer()
        return cb
    async def _on_next(self, interaction):
        if interaction.user.id != self.uid: return
        store = pending_admin if self.mode == "admin" else pending_char
        store.setdefault(self.uid, {}); store[self.uid].update(self.data)
        av2 = AppearanceViewStep2(self.uid, self.race, self.gender, self.element, self.mode, dict(self.data))
        await interaction.response.edit_message(embed=av2._embed(), view=av2)
    def _embed(self):
        lines = ["**Шаг 1 из 2:**", "_Возраст, телосложение, волосы._", ""]
        lb = {"age":"Возраст","build":"Телосложение","hair":"Волосы"}
        for k in ["age","build","hair"]:
            lines.append(f"**{lb[k]}:** {self.data.get(k,'—')}")
        return discord.Embed(title="🎨 Внешность (1/2)", description="\n".join(lines), color=0x805ad5)


