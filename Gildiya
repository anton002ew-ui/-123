    else:
        fallback = {"type": "brand", "text": "Клеймо преступника"}
    try:
        async with aiohttp.ClientSession() as s:
            async with s.post(TEXT_API_URL, json=payload, headers=headers, timeout=30) as r:
                if r.status != 200: return fallback
                data = await r.json()
                txt = data['choices'][0]['message']['content']
                a = txt.find('{'); b = txt.rfind('}')
                if a >= 0 and b > a:
                    obj = json.loads(txt[a:b+1])
                    t = obj.get('type', fallback['type'])
                    if t not in PUNISHMENTS: t = fallback['type']
                    result = {"type": t, "text": str(obj.get('text', fallback.get('text','—')))[:100]}
                    if t == "jail":
                        result['minutes'] = max(10, min(720, int(obj.get('minutes', 120))))
                        result['bail'] = max(50, min(2000, int(obj.get('bail', 300))))
                    return result
    except: pass
    return fallback


async def ai_calculate_debuff_duration(player_name, city, severity, pun_type, brands_in_city):
    base_ranges = {
        "pillory": (1, 4, "hours"),
        "rods":    (2, 6, "hours"),
        "brand":   (7, 90, "days"),
    }
    lo, hi, unit = base_ranges.get(pun_type, (1, 4, "hours"))
    prompt = (
        f"Определи длительность наказания.\n"
        f"Игрок: {player_name}, город: {city}, тяжесть: {severity}/3.\n"
        f"Наказание: {PUNISHMENTS.get(pun_type, {}).get('name', pun_type)}.\n"
        f"Клейм уже: {brands_in_city}.\n"
        f"Диапазон: {lo}-{hi} {unit}.\n"
        f'Верни JSON: {{"duration": {lo}, "reason": "кратко"}}'
    )
    headers = {"Authorization": f"Bearer {API_KEY_TEXT}", "Content-Type": "application/json"}
    payload = {"model": TEXT_MODEL, "messages": [{"role": "user", "content": prompt}], "max_tokens": 120}
    fallback_duration = lo + severity * ((hi - lo) // 3)
    try:
        async with aiohttp.ClientSession() as s:
            async with s.post(TEXT_API_URL, json=payload, headers=headers, timeout=30) as r:
                if r.status != 200: return fallback_duration, unit, "стандартное наказание"
                data = await r.json()
                txt = data['choices'][0]['message']['content']
                a = txt.find('{'); b = txt.rfind('}')
                if a >= 0 and b > a:
                    obj = json.loads(txt[a:b+1])
                    dur = int(obj.get('duration', fallback_duration))
                    dur = max(lo, min(hi, dur))
                    return dur, unit, str(obj.get('reason', 'стандартное наказание'))[:150]
    except: pass
    return fallback_duration, unit, "стандартное наказание"


