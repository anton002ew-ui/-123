async def ai_distribute_reward(members, contribs):
    if len(members) == 1:
        return {members[0]: 1.0}
    if not contribs:
        share = 1.0 / len(members)
        return {m: share for m in members}
    contrib_map = {c['discord_id']: c for c in contribs}
    data_lines = []
    for m in members:
        c = contrib_map.get(m, {})
        dmg  = int(c.get('damage', 0) or 0)
        heal = int(c.get('healed', 0) or 0)
        sup  = int(c.get('support', 0) or 0)
        pl = await db_get_player(m)
        name = pl['name'] if pl else f"ID {m}"
        data_lines.append(f"id={m} ({name}): damage={dmg} healed={heal} support={sup}")
    prompt = (
        f"Распредели 100% награды по вкладу.\n\n"
        f"**Вклад:**\n" + "\n".join(data_lines) + "\n\n"
        f"Правила: damage основной, healed = damage, support = 0.5×damage.\n"
        f"Минимум 10% каждому. Сумма = 100.\n\n"
        f'Верни JSON: {{"shares": {{"<id>": <процент>, ...}}}}'
    )
    headers = {"Authorization": f"Bearer {API_KEY_TEXT}", "Content-Type": "application/json"}
    payload = {"model": TEXT_MODEL, "messages": [{"role": "user", "content": prompt}], "max_tokens": 300}
    try:
        async with aiohttp.ClientSession() as s:
            async with s.post(TEXT_API_URL, json=payload, headers=headers, timeout=30) as r:
                if r.status != 200: return _default_reward_shares(members, contrib_map)
                data = await r.json()
                txt = data['choices'][0]['message']['content']
                a = txt.find('{'); b = txt.rfind('}')
                if a >= 0 and b > a:
                    obj = json.loads(txt[a:b+1])
                    raw = obj.get('shares', {})
                    result = {}
                    total = 0.0
                    for m in members:
                        v = raw.get(str(m), raw.get(m, 0))
                        try: v = float(v)
                        except: v = 0
                        v = max(10.0, v)
                        result[m] = v
                        total += v
                    if total > 0:
                        for m in result: result[m] /= total
                        return result
    except: pass
    return _default_reward_shares(members, contrib_map)


def _default_reward_shares(members, contrib_map):
    scores = {}
    total = 0.0
    for m in members:
        c = contrib_map.get(m, {})
        score = ((c.get('damage', 0) or 0)
                 + (c.get('healed', 0) or 0)
                 + (c.get('support', 0) or 0) * 0.5)
        score = max(1.0, score)
        scores[m] = score
        total += score
    return {m: s / total for m, s in scores.items()}


async def build_group_member_options(gid, page=0, per_page=25):
    g = await db_get_quest_group(gid)
    if not g: return [], 0, 0
    members = json.loads(g['members'] or '[]')
    async with aiosqlite.connect(DB_PATH) as db:
        db.row_factory = aiosqlite.Row
        async with db.execute("""SELECT discord_id, name, race, level, location
            FROM players WHERE is_alive=1 AND is_abandoned_spirit=0""") as cur:
            all_players = [dict(r) for r in await cur.fetchall()]
    async with aiosqlite.connect(DB_PATH) as db:
        db.row_factory = aiosqlite.Row
        async with db.execute("""SELECT * FROM quest_groups
            WHERE status IN ('forming','active')""") as cur:
            all_groups = [dict(r) for r in await cur.fetchall()]
    busy = set()
    for og in all_groups:
        if og['id'] == gid: continue
        busy.add(og['leader_id'])
        for m in json.loads(og['members'] or '[]'): busy.add(m)
    available = []
    for p in all_players:
        uid = p['discord_id']
        if uid == g['leader_id']: continue
        if uid in members: continue
        if uid in busy: continue
        available.append(p)
    total_pages = max(1, (len(available) + per_page - 1) // per_page)
    page = max(0, min(page, total_pages - 1))
    s0 = page * per_page
    items = available[s0:s0 + per_page]
    options = [discord.SelectOption(
        label=f"{p['name']} ({p['race']} ур.{p['level']})"[:80],
        value=str(p['discord_id']),
        description=f"📍 {p['location'] or '—'}"[:100]) for p in items]
    return options, total_pages, page


