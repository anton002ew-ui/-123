async def open_group_menu(interaction, qid):
    p = await db_get_player(interaction.user.id)
    if not p:
        await interaction.response.send_message("❌ Нет персонажа.", ephemeral=True); return
    my_group = await db_get_player_group(interaction.user.id)
    embed = discord.Embed(title="👥 Группа для заказа", color=0x805ad5)
    if my_group:
        members = json.loads(my_group['members'] or '[]')
        member_lines = []
        for m in members:
            mark = "👑" if m == my_group['leader_id'] else "👤"
            pl = await db_get_player(m)
            name = pl['name'] if pl else f"ID {m}"
            member_lines.append(f"{mark} **{name}**")
        embed.description = (
            f"**Группа:** {my_group['name']}\n"
            f"**Участники ({len(members)}/{MAX_GROUP_SIZE}):**\n"
            + ("\n".join(member_lines) or "—") + "\n\n"
            "• 🎭 Добавить участников\n"
            "• ✅ Взять заказ группой\n"
            "• ❌ Распустить группу")
        if my_group['leader_id'] == interaction.user.id:
            view = GroupManageView(my_group['id'], qid)
        else:
            view = GroupMemberView(my_group['id'], qid)
    else:
        embed.description = (
            "У вас нет группы.\n\n"
            f"**Создать группу** — соберите до **{MAX_GROUP_SIZE}** игроков.\n\n"
            "• Награда делится по вкладу через ИИ\n"
            "• Штраф при провале — поровну")
        view = GroupCreateView(qid)
    try: await interaction.response.send_message(embed=embed, view=view, ephemeral=True)
    except: await interaction.followup.send(embed=embed, view=view, ephemeral=True)


