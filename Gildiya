async def start_dungeon_run(interaction, dungeon):
    p = await db_get_player(interaction.user.id)
    if not p: return
    ls, _ = await db_get_dungeon_cooldown(interaction.user.id)
    if ls > 0:
        h = ls//3600; m = (ls%3600)//60
        await interaction.response.send_message(f"⏱️ КД: {h}ч {m}м.", ephemeral=True); return
    ex = await db_get_user_gameplay_thread(interaction.user.id)
    if ex:
        th = interaction.guild.get_thread(ex['thread_id'])
        if th:
            await interaction.response.send_message(f"❌ Уже в: {th.mention}", ephemeral=True); return
        await db_delete_gameplay_thread(ex['thread_id'])
    try:
        thread = await interaction.channel.create_thread(name=f"🕳️ {dungeon['name']}"[:100],
            type=discord.ChannelType.private_thread, invitable=False)
        await thread.add_user(interaction.user)
    except Exception as e:
        await interaction.response.send_message(f"❌ {e}", ephemeral=True); return
    await add_admins_to_thread(thread, interaction.guild)
    await db_create_dungeon_session(thread.id, dungeon['id'], interaction.user.id,
                                     dungeon.get('biome','plains'))
    await db_save_gameplay_thread(thread.id, interaction.user.id, [interaction.user.id],
        is_battle=0, location=dungeon['name'], in_city=0,
        story_summary=f"Подземелье {dungeon['name']}")
    await enter_dungeon_room(thread, dungeon, 1, p)
    try: await interaction.response.send_message(f"✅ {thread.mention}", ephemeral=True)
    except: pass


