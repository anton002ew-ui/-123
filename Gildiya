async def get_player_context(player_id, thread_id=None):
    p = await db_get_player(player_id)
    if not p or p['is_alive'] == 0:
        return {"alive": False, "buttons": [], "p": p}

    ctx = {"alive": True, "p": p, "in_battle": False, "in_dungeon": False,
           "dungeon_room": 0,
           "in_city": p.get('in_city', 1) == 1,
           "in_temple": p.get('in_temple', 0) == 1,
           "in_wild": p.get('in_city', 1) == 0 and p.get('in_temple', 0) == 0,
           "has_quest": False, "can_deliver": False, "near_poi": False,
           "can_gather": False, "near_corpse": False, "near_spirit": False,
           "has_food": False, "has_cross": False,
           "biome": "plains", "location_name": p.get('location') or "—", "buttons": []}

    px = p.get('player_x', 100) or 100
    py = p.get('player_y', 100) or 100
    ctx["biome"] = get_biome_at(px, py)

    # --- АФК ---
    if p.get('is_afk') == 1:
        ctx["buttons"] = ["afk_exit", "map", "profile"]
        return ctx

    # --- Сон ---
    if p.get('is_sleeping') == 1:
        ctx["buttons"] = ["wake", "map", "profile"]
        return ctx

    # --- Тюрьма ---
    if p.get('in_jail') == 1:
        ctx["buttons"] = ["bail", "mycrimes", "map", "profile"]
        return ctx

    # --- Брошенный дух ---
    if p.get('is_abandoned_spirit') == 1:
        corpses = await get_nearby_possessable_corpses(px, py, radius=5)
        b = ["help_spirit"]
        if corpses: b.append("possess")
        b += ["map", "profile"]
        ctx["buttons"] = b
        return ctx

    # --- Бой / подземелье ---
    if thread_id:
        t = await db_get_gameplay_thread(thread_id)
        if t and t['is_battle']: ctx["in_battle"] = True
        sess = await db_get_dungeon_session(thread_id)
        if sess:
            ctx["in_dungeon"] = True
            ctx["dungeon_room"] = sess['room']

    async with aiosqlite.connect(DB_PATH) as db:
        async with db.execute("SELECT COUNT(*) FROM quest_board WHERE taken_by=? AND status='taken'",
                             (player_id,)) as cur:
            ctx["has_quest"] = (await cur.fetchone())[0] > 0
        db.row_factory = aiosqlite.Row
        async with db.execute("""SELECT * FROM quest_board
            WHERE taken_by=? AND status='taken' AND quest_kind IN ('delivery','state')""",
            (player_id,)) as cur:
            for q in await cur.fetchall():
                if ((q['x'] - px) ** 2 + (q['y'] - py) ** 2) ** 0.5 <= 5:
                    ctx["can_deliver"] = True; break

    if ctx["in_wild"] and get_herbs_for_biome(ctx["biome"]):
        ctx["can_gather"] = True
    if ctx["in_wild"]:
        pois = await find_nearby_poi(px, py, radius=5)
        ctx["near_poi"] = len(pois) > 0

    inv = await get_player_inventory(player_id)
    inv_map = {}
    for i in inv: inv_map[i['item_id']] = inv_map.get(i['item_id'], 0) + i['count']
    for iid, cnt in inv_map.items():
        if ITEMS.get(iid, {}).get('cat') == "food" and cnt > 0:
            ctx["has_food"] = True; break
    if inv_map.get("Крест", 0) > 0: ctx["has_cross"] = True

    if ctx["has_cross"]:
        async with aiosqlite.connect(DB_PATH) as db:
            db.row_factory = aiosqlite.Row
            async with db.execute("""SELECT * FROM players
                WHERE race='Фантазмы' AND is_alive=1
                  AND (is_abandoned_spirit=1 OR in_spirit_form=1)""") as cur:
                for s in await cur.fetchall():
                    d = ((s.get('player_x', 100) - px) ** 2 +
                         (s.get('player_y', 100) - py) ** 2) ** 0.5
                    if d <= 5 and s['discord_id'] != player_id:
                        ctx["near_spirit"] = True; break

    b = []
    if ctx["in_battle"]:
        b = ["attack", "defend", "use_item", "inventory", "flee", "sacrifice"]
    elif ctx["in_dungeon"]:
        if ctx["dungeon_room"] == 3: b = ["open_chest", "inventory", "flee"]
        elif ctx["dungeon_room"] == 4: b = ["attack", "defend", "use_item", "inventory"]
        else: b = ["attack", "defend", "use_item", "inventory", "flee"]
    elif ctx["in_city"] or ctx["in_temple"]:
        b = ["residents", "trade", "masters", "work", "help_npc", "craft"]
        # дома
        house = await get_player_house(player_id)
        if house and house['city'] == (p.get('location') or ""):
            if p.get('is_sleeping') != 1:
                b.insert(0, "sleep")
            b.insert(1, "myhouse")
        b.append("houses")
        # еда
        if ctx["has_food"]: b.append("eat")
        if ctx["can_deliver"]: b.insert(0, "deliver")
        if ctx["has_quest"]: b.append("my_quests")
        b += ["quests", "reputation", "inventory", "profile", "map", "lockpick"]
        # кража
        if not p.get('in_jail') and p.get('is_sleeping') != 1:
            b.append("steal")
        # клейма
        brands = await get_all_player_brands(player_id)
        if brands: b.append("mycrimes")
        # узник рядом
        async with aiosqlite.connect(DB_PATH) as db:
            async with db.execute("""SELECT COUNT(*) FROM players
                WHERE in_city=1 AND in_jail=1 AND location=? AND discord_id!=?""",
                (p.get('location'), player_id)) as cur:
                if (await cur.fetchone())[0] > 0:
                    b.append("deliver_player")
        if ctx["near_spirit"]: b.append("exorcise")
        b += ["chronicle", "world_events", "afk", "leave"]
    else:
        if ctx["can_gather"]: b.append("gather")
        if ctx["near_poi"]: b.append("look_around")
        b.append("dungeons")
        if ctx["has_quest"]: b.append("my_quests")
        if ctx["can_deliver"]: b.insert(0, "deliver")
        b += ["quests", "inventory", "profile", "map", "return_city", "adventure", "afk"]
        if ctx["has_food"]: b.insert(3, "eat")

    if p['race'] == "Фантазмы":
        if p.get('in_spirit_form') == 1:
            b.append("spirit_in")
        elif p.get('possessed_corpse_id') is None and p.get('body_dead') != 1:
            b.append("spirit_out")

    ctx["buttons"] = b
    return ctx


def context_location_text(ctx):
    p = ctx["p"]
    if p.get('is_afk') == 1: return "💤 **АФК — защищён от всех механик**"
    if p.get('is_sleeping') == 1: return "😴 **Спит в доме**"
    if p.get('in_jail') == 1: return f"🔒 **Тюрьма {p.get('jail_city') or ''}**"
    if p.get('is_abandoned_spirit') == 1:
        return "🌫️ **Брошенный дух**\n⏱️ 24ч на вселение или смерть"
    if p.get('in_spirit_form') == 1:
        body_hp = p.get('body_hp') or 0
        body_txt = "💀 мертво" if body_hp <= 0 else f"{body_hp} HP"
        return (f"👻 **Форма духа** · тело: {body_txt}\n"
                f"*Уязвим только для магии, свитков и ритуала*")
    if p.get('possessed_corpse_id'):
        return f"🎭 **Вселён в тело**"
    if ctx["in_battle"]: return "⚔️ **Бой**"
    if ctx["in_dungeon"]: return f"🕳️ **Подземелье** ({ctx['dungeon_room']}/4)"
    if ctx["in_city"]: return f"🏘 **{ctx['location_name']}**"
    if ctx["in_temple"]: return f"⛪ **{ctx['location_name']}**"
    return f"🌲 **Дикая** · {get_biome_name(ctx['biome'])}"


