    priest_bonus = prof_b.get('heal_bonus', 0)
    total_bonus = intl_bonus + priest_bonus
    res, _, _ = await animate_dice_roll(interaction.channel, 20,
        prefix="Ритуал изгнания", target=15, bonus=total_bonus)

    if res + total_bonus >= 15:
        await db_save_player({**tp, "is_alive": 0, "lives": 0, "hp": 0,
                              "in_spirit_form": 0, "is_abandoned_spirit": 0,
                              "possessed_corpse_id": None,
                              "death_time": datetime.utcnow().isoformat()})
        await db_add_corpse(target.id, tp['name'], tp['race'], tp['level'],
                            datetime.utcnow().isoformat())
        if tp.get('possessed_corpse_id'):
            async with aiosqlite.connect(DB_PATH) as db:
                await db.execute("DELETE FROM possessable_corpses WHERE id=?",
                                 (tp['possessed_corpse_id'],))
                await db.commit()
        try:
            for g in bot.guilds:
                m = g.get_member(target.id)
                if m: await remove_race_role_and_nick(g, m, "Фантазмы")
        except: pass
        broke = random.random() < 0.7
        if broke:
            await remove_inventory_item(interaction.user.id, "Крест", 1)
