async def check_foreign_brand_recognition(player, new_city):
    all_brands = await get_all_player_brands(player['discord_id'])
    foreign = [b for b in all_brands if b['city'] != new_city]
    if not foreign:
        return False, None
    chance = min(0.30, 0.05 * len(foreign))
    if random.random() < chance:
        await change_city_reputation(player['discord_id'], new_city, -3)
        b0 = foreign[0]
        text = (f"🧐 Кто-то из местных прищурился, глядя на твоё плечо.\n"
                f"*«Кажется, я тебя где-то видел... в {b0['city']}?»*\n\n"
                f"Слухи о тебе дошли и сюда. Репутация в **{new_city}**: −3")
        return True, text
    return False, None


