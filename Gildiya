                            healed=c.get('healed', 0) or 0,
                            support=c.get('support', 0) or 0)
                    pl = await db_get_player(t['owner_id'])
                    dq = await try_complete_quest(pl, t['enemy_name'],
                        x=pl.get('player_x',100), y=pl.get('player_y',100),
                        thread_id=tid)
                    await db_clear_contributions(tid)
                    if dq:
                        await interaction.channel.send(f"🏆 Заказ #{dq['id']} выполнен!")
                except Exception as e:
                    print(f"[QUEST COMPLETE] {e}")
        else:
            es = json.loads(t['enemy_stats'] or '{}')
            await db_save_gameplay_thread(tid, t['owner_id'], json.loads(t['participants'] or '[]'),
