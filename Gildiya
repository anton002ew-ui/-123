def _profile_for(item_id, item):
    """Определяет профиль статов предмета по его категории."""
    cat = item.get('cat')
    if cat == "weapon":
        if item.get("mag", 0) >= 3: return "weapon_magic"
        if "лук" in item_id.lower() or "арбалет" in item_id.lower():
            return "weapon_bow"
        return "weapon_main"
    if cat == "shield": return "shield"
    if cat == "armor":
        s = item.get('slot')
        return {"body": "armor_body", "head": "armor_head",
                "hands": "armor_hands", "feet": "armor_feet"}.get(s, "armor_body")
    if cat == "amulet":
        return "ring" if item.get('slot') == "ring" else "amulet"
    return "weapon_main"


def roll_item_stats(item_id, rarity=0, quality=1):
    """Роллит статы одного экземпляра предмета."""
    item = ITEMS.get(item_id)
    if not item: return {}, 0
    pool = ITEM_STAT_PROFILE.get(_profile_for(item_id, item), ["atk"])
    power = RARITY_MULT.get(rarity, 1.0) * (1.0 + (quality - 1) * 0.10)
    rolled = {}
    for stat in pool:
        base_val = item.get(stat, 0)
        if base_val <= 0:
            if random.random() < 0.35: base_val = 1
            else: continue
        lo = max(1, int(base_val * 0.75))
        hi = max(1, int(base_val * 1.25)) + 1
        rolled[stat] = max(1, int(random.randint(lo, hi) * power))
    if rarity >= 2:
        all_stats = STAT_POOL.get(item.get('cat', 'weapon'), ["atk"])
        extra = random.choice([s for s in all_stats if s not in rolled] or ["hp"])
        rolled[extra] = rolled.get(extra, 0) + rarity * 2
    if rarity >= 4:
        rolled["hp"] = rolled.get("hp", 0) + rarity * 3
    rolled_dmg = 0
    if item.get('cat') == "weapon":
        bd = item.get('dmg', 0)
        lo = max(1, int(bd * 0.8))
        hi = max(1, int(bd * 1.2)) + 1
        rolled_dmg = max(1, int(random.randint(lo, hi) * power))
    return rolled, rolled_dmg


def describe_rolled_stats(rolled, rolled_dmg=0):
    """Формирует список строк для отображения статов предмета."""
    lines = []
    sn = {"atk": "⚔️ ATK", "def": "🛡 DEF", "mdef": "🔮 MDEF",
          "mag": "✨ MAG", "spd": "💨 SPD", "intl": "🧠 INTL",
          "hp": "❤️ HP", "luck": "🍀 Удача", "crit": "💥 Крит"}
    if rolled_dmg: lines.append(f"⚔️ Урон: **{rolled_dmg}**")
    for k, v in rolled.items():
        lines.append(f"{sn.get(k, k)}: **+{v}**")
    return lines or ["—"]


def roll_rarity(source="normal"):
    """Роллит редкость по источнику."""
    table = RARITY_TABLE.get(source, RARITY_TABLE["normal"])
    r = random.random(); acc = 0
    for rarity, chance in table:
        acc += chance
        if r <= acc: return rarity
    return 0


def roll_item_from_pool(pool, source="normal"):
    """Случайный предмет из пула с роллом редкости/качества."""
    if not pool: return None
    iid = random.choice(pool)
    rarity = roll_rarity(source)
    quality = 1
    if rarity >= 2 and random.random() < 0.4: quality = 2
    if rarity >= 4 and random.random() < 0.3: quality = 3
    return {"item_id": iid, "rarity": rarity, "quality": quality}


