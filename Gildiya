        g = await db_get_quest_group(group_id)
        if g:
            members = json.loads(g['members'] or '[]')
            recipients = members or [taken_by]
        else:
            recipients = [taken_by]
    else:
        recipients = [taken_by]

    contribs = []
    if thread_id:
        contribs = await db_get_contributions(thread_id)

    shares = await ai_distribute_reward(recipients, contribs)

    details = []
    for uid, share in shares.items():
        gold = int(round(reward * share))
        await give_gold(uid, gold, f"заказ #{qid}")
