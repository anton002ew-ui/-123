async def find_nearby_poi(px, py, radius=5):
    pois = []
    for name,(cx,cy) in CITY_COORDS.items():
        d = ((cx-px)**2+(cy-py)**2)**0.5
        if d <= radius: pois.append({"type":"city","name":name,"x":cx,"y":cy,"dist":d})
    for name,(cx,cy) in VILLAGES.items():
        d = ((cx-px)**2+(cy-py)**2)**0.5
        if d <= radius: pois.append({"type":"village","name":name,"x":cx,"y":cy,"dist":d})
    for name,(cx,cy) in RUINS.items():
        d = ((cx-px)**2+(cy-py)**2)**0.5
        if d <= radius: pois.append({"type":"ruins","name":name,"x":cx,"y":cy,"dist":d})
    for dng in await db_get_active_dungeons():
        d = ((dng['x']-px)**2+(dng['y']-py)**2)**0.5
        if d <= radius:
            pois.append({"type":"dungeon","name":dng['name'],"x":dng['x'],"y":dng['y'],
                         "dist":d,"id":dng['id'],"boss":dng.get('boss','?'),"level":dng.get('level',1)})
    for t in await db_get_all_wild_temples():
        d = ((t['x']-px)**2+(t['y']-py)**2)**0.5
        if d <= radius:
            pois.append({"type":"temple","name":t['name'],"x":t['x'],"y":t['y'],"dist":d,"id":t['id']})
    pois.sort(key=lambda x: x['dist'])
    return pois


