class ProfessionModal(ui.Modal, title="Профессии"):
    uid = ui.TextInput(label="Discord ID", max_length=30)
    prof = ui.TextInput(label="Профессия", max_length=60, required=False, default="")
    action = ui.TextInput(label="add/remove/bonus", max_length=10, default="add")
    temp_prof = ui.TextInput(label="Проф бонуса", max_length=60, required=False, default="")
    async def on_submit(self, interaction):
        await interaction.response.defer(ephemeral=True)
        try: uid = int(self.uid.value.strip())
        except ValueError: return
        action = self.action.value.strip().lower(); pn = self.prof.value.strip()
        p = await db_get_player(uid)
        if not p: return
        profs = json.loads(p['professions'] or '[]')
        if not profs and p['profession'] not in ("Новичок","Нет"): profs = [p['profession']]
        bonus = p['bonus_profession_slots'] or 0; mx = MAX_PROFESSIONS+bonus
        if action == "bonus":
            if p.get('trial_completed',0) == 1: return
            tp = self.temp_prof.value.strip()
            if not tp or tp not in profs: return
            sk = RACES[p['race']].get("trial_stat","intl")
            nb = json.loads(p['bonus_stats'] or '{}'); nb[sk] = nb.get(sk,0)+2
            until = (datetime.utcnow()+timedelta(days=30)).isoformat()
            upd = {**p, "bonus_stats":json.dumps(nb), "bonus_profession_slots":bonus+1,
                   "trial_completed":1, "temp_bonus_type":tp, "temp_bonus_until":until}
