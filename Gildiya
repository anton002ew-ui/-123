class QuestPageView(ui.View):
    def __init__(self, qid, idx, total):
        super().__init__(timeout=300)
        self.qid = qid; self.idx = idx; self.total = total
        if idx > 0:
            b = ui.Button(label="◀", style=discord.ButtonStyle.secondary, row=1)
            b.callback = self._prev; self.add_item(b)
        b = ui.Button(label="✋ Взять", style=discord.ButtonStyle.success, row=1)
        b.callback = self._take; self.add_item(b)
        b = ui.Button(label="👥 Группа", style=discord.ButtonStyle.primary, row=1)
        b.callback = self._group; self.add_item(b)
        if idx < total - 1:
            b = ui.Button(label="▶", style=discord.ButtonStyle.secondary, row=1)
            b.callback = self._next; self.add_item(b)
    async def _prev(self, interaction):
        qs = await get_open_quests()
        if self.idx - 1 < 0: return
        await show_quest_page(interaction, qs, self.idx - 1)
    async def _next(self, interaction):
        qs = await get_open_quests()
        if self.idx + 1 >= len(qs): return
        await show_quest_page(interaction, qs, self.idx + 1)
    async def _take(self, interaction):
        await try_take_quest(interaction, self.qid)
    async def _group(self, interaction):
        await open_group_menu(interaction, self.qid)


