async def check_jail(player):
    if not player.get('in_jail'): return False, None
    until = player.get('jail_until')
    if not until: return False, None
    try:
        end = datetime.fromisoformat(until)
        if datetime.utcnow() >= end:
            return False, None
        left = (end - datetime.utcnow()).total_seconds() / 60
        return True, int(left)
    except: return False, None


