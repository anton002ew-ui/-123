                source = "boss"
            else: source = "normal"

            is_ruins_fight = "руины" in (t['enemy_name'] or "").lower() or t['location'] in RUINS
            if is_ruins_fight:
                for uid in parts:
                    pl = await db_get_player(uid)
                    if pl:
                        try: await handle_ruin_loot(pl, t['location'])
                        except Exception as e: print(f"[RUINS LOOT] {e}")
            else:
                for uid in parts:
                    loot = roll_loot(t['enemy_name'], enemy_lvl, source, "plains",
