async def process_battle_result(interaction, p, t, success, result, spec, action):
    tid = interaction.channel.id

    if success:
        eff = parse_active_effects(p)
        if 'invisible' in eff:
            del eff['invisible']
            await db_save_player({**dict(p), "active_effects": json.dumps(eff)})
            await interaction.channel.send("👁 Невидимость прервана.")

    p_stats = await get_player_combat_stats(p)
    enemy_stats_dict = (json.loads(t['enemy_stats'] or '{}')
                        if t and isinstance(t.get('enemy_stats'), str)
                        else (t.get('enemy_stats') if t else {}) or {})
    enemy_def = int(enemy_stats_dict.get('def', 0))
    enemy_mdef = int(enemy_stats_dict.get('mdef', 0))
    enemy_atk = int(enemy_stats_dict.get('atk', 5))

    # Тип атаки игрока
    is_magic_attack = False
    equipped = await get_equipped_items(interaction.user.id)
    weapon = equipped.get('main')
    if weapon:
        wit = ITEMS.get(weapon['item_id'], {})
        if wit.get('mag', 0) >= 3: is_magic_attack = True

    # Фантазм-дух — только магия
    enemy_name_l = (t['enemy_name'] or "").lower() if t else ""
    is_spirit_target = ("фантазм" in enemy_name_l or "дух" in enemy_name_l)

    if is_spirit_target and not is_magic_attack:
        if p['race'] == "Ангелы":
            is_magic_attack = True
        else:
            await interaction.channel.send(embed=discord.Embed(
                title="👻 Промах!",
                description=("**Физическое оружие проходит сквозь дух.**\n\n"
                             "Попасть можно только:\n"
                             "• 🔮 **Магическим оружием** (посох MAG ≥ 3)\n"
                             "• 📜 **Свитками**\n"
                             "• ✝️ **Ритуалом** (`/exorcise` с Крестом)"),
                color=0x4a5568))
            return

    # УРОН ИГРОКА
    if t and t['is_battle']:
        if is_magic_attack:
            raw = p_stats['mag'] - enemy_mdef * 0.5
            atk_label = f"MAG {p_stats['mag']} vs MDEF {enemy_mdef}"
            icon = "🔮"
        else:
            raw = p_stats['atk'] - enemy_def * 0.5
            atk_label = f"ATK {p_stats['atk']} vs DEF {enemy_def}"
            icon = "💥"
        mult = 1.5 if success else 0.7
        dmg = max(1, int(raw * mult))
        await db_add_contribution(tid, interaction.user.id, damage=dmg)
        crit_text = " ✨ **КРИТ!**" if success else ""
        bar = _hp_bar(max(0, t['enemy_hp'] - dmg), t['enemy_max_hp'])
        await interaction.channel.send(embed=discord.Embed(
            description=(f"{icon} **{p['name']}** наносит **{dmg}** урона{crit_text}\n"
                         f"-# {atk_label}\n\n"
                         f"**{t['enemy_name']}**\n{bar} **{max(0, t['enemy_hp']-dmg)}/{t['enemy_max_hp']}**"),
            color=EMBED_COLORS["battle"]))

    # ПРОВЕРКА СМЕРТИ МОБА
    if t and t['is_battle'] and success:
        hp_left = max(0, t['enemy_hp'] - dmg)
        if hp_left <= 0:
            enemy_lvl = t['enemy_level']; parts = json.loads(t['participants'] or '[]')
            total_pool = (BATTLE_BASE_XP + enemy_lvl * BATTLE_XP_PER_LVL) * len(parts)
            contribs = await db_get_contributions(tid)
            tp = sum((c['damage'] or 0)+(c['healed'] or 0)+(c['support'] or 0) for c in contribs) or 1
            rl = []
            for c in contribs:
                cp = (c['damage'] or 0)+(c['healed'] or 0)+(c['support'] or 0)
                sh = max(CONTRIBUTION_MIN, cp/tp)
                bg = int(total_pool*sh/max(1,len(contribs)))
                pl = await db_get_player(c['discord_id'])
                if not pl: continue
                g, left = await add_xp_capped(pl, bg)
