        f'ВЕРНИ JSON: {{"real_name":true,"gender_match":true,"detected_gender":"Мужчина",'
        f'"reason":"кратко","corrected":""}}')
    headers = {"Authorization": f"Bearer {API_KEY_TEXT}", "Content-Type": "application/json"}
    payload = {"model": TEXT_MODEL, "messages": [{"role":"user","content":prompt}], "max_tokens": 250}
    fb = {"valid":True,"real_name":True,"gender_match":True,
          "detected_gender":"Универсальное","reason":"Пропуск","corrected":""}
    try:
        async with aiohttp.ClientSession() as s:
            async with s.post(TEXT_API_URL, json=payload, headers=headers, timeout=45) as r:
                if r.status != 200: return fb
                data = await r.json()
                txt = data['choices'][0]['message']['content']
                a = txt.find('{'); b = txt.rfind('}')
                if a >= 0 and b > a:
                    obj = json.loads(txt[a:b+1])
                    real = bool(obj.get('real_name', True)); gmatch = bool(obj.get('gender_match', True))
                    return {"valid":real and gmatch,"real_name":real,"gender_match":gmatch,
                            "detected_gender":obj.get('detected_gender','Универсальное'),
                            "reason":str(obj.get('reason',''))[:200],
                            "corrected":str(obj.get('corrected',''))[:40]}
    except Exception as e: print(f"[AI NAME ERR] {e}")
    return fb


