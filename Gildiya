async def animate_dice_roll(channel, dice_sides, prefix="", target=None, bonus=0):
    spin = ["⚀","⚁","⚂","⚃","⚄","⚅"]
    try: msg = await channel.send(f"🎲 **{prefix}** Бросок d{dice_sides}...")
    except: return random.randint(1, dice_sides), "", None
    for _ in range(5):
        fake = random.randint(1, dice_sides)
        try: await msg.edit(content=f"🎲 **{prefix}** {random.choice(spin)} ... **{fake}**")
        except: pass
        await asyncio.sleep(0.35)
    await asyncio.sleep(0.4)
    res = random.randint(1, dice_sides); total = res + bonus
    if target is not None:
        ok = total >= target; icon = "✅" if ok else "❌"
        bt = f" + {bonus}" if bonus else ""
        final = f"{icon} **{prefix}** — d{dice_sides} = **{res}**{bt} → **{total}** (нужно {target}+)"
    else:
        final = f"🎲 **{prefix}** — d{dice_sides} = **{res}**"
    try: await msg.edit(content=final)
    except: pass
    return res, final, msg


