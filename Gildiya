    AGGRESSIVE = ["атак","удар","бью","бей","стрел","брос","убь","убив","руб","колю","реж","режу",
                  "топч","жг","сраж","бой","напад","рву","грызу","душ","копь","меч","кинжал","кулак","ног","зуб"]
    if not any(w in action_text.lower() for w in AGGRESSIVE): return None
    t = await db_get_gameplay_thread(thread.id)
    if not t or t['is_battle'] or t['in_city'] == 1: return None
    if random.random() > 0.30: return None
    px = player.get('player_x',100) or 100; py = player.get('player_y',100) or 100
    biome = get_biome_at(px, py); pool = get_monsters_by_biome(biome)
    if not pool: return None
    mt = random.choice(pool); lvl = max(1, player['level'] + random.randint(-2,2))
    monster = generate_monster_pack(1, lvl, mt, is_boss=False)
    debuffs = []
    if random.random() < 0.30:
        monster['atk'] = int(monster['atk'] * 0.85); debuffs.append("🍖 голоден")
    if random.random() < 0.30:
        monster['def'] = int(monster['def'] * 0.80); debuffs.append("😴 не спал")
    ab = get_ability_bonus(player); stealth = ab.get('stealth',0) + ab.get('invisible',0)
    if random.random() > 0.85 - stealth*0.15 + monster['spd']*0.005:
        monster['spd'] = int(monster['spd'] * 0.7); debuffs.append("👁 не видит")
    if random.random() < 0.15:
        await thread.send(embed=discord.Embed(title=f"👣 {mt} прошёл мимо", color=0x4a5568)); return None
    parts = json.loads(t['participants'] or '[]')
    await db_save_gameplay_thread(thread.id, t['owner_id'], parts, is_battle=1, enemy_name=mt,
        enemy_stats=monster, enemy_hp=monster['hp'], enemy_max_hp=monster['max_hp'],
        enemy_level=lvl, location=t['location'], in_city=t['in_city'], story_summary=t['story_summary'] or "")
