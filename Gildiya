async def get_player_combat_stats(p):
    base  = get_race_stats(p['race'])
    bonus = json.loads(p['bonus_stats'] or '{}')
    eq    = await get_equipment_bonuses(p['discord_id'])
    ab    = get_ability_bonus(p)
    prof_b = total_profession_bonuses(p)

    atk = base['atk'] + bonus.get('atk', 0) + eq.get('atk', 0) + ab.get('atk_flat', 0)
    atk += prof_b.get('atk_bonus', 0)
    atk = int(atk * ab.get('atk_mult', 1.0))

    dfn = base['def'] + bonus.get('def', 0) + eq.get('def', 0)
    dfn = int(dfn * ab.get('def_mult', 1.0))

    mdef = base['mdef'] + bonus.get('mdef', 0) + eq.get('mdef', 0)
    mag  = base['mag']  + bonus.get('mag', 0)  + eq.get('mag', 0)

    equipped = await get_equipped_items(p['discord_id'])
    eq_weight = sum(get_item_weight(inv['item_id']) for inv in equipped.values())
    inv = await get_player_inventory(p['discord_id'])
    inv_weight = sum(get_item_weight(i['item_id']) * i['count']
                     for i in inv if not i.get('equipped_slot'))
    total_weight = eq_weight + inv_weight
    cap = p.get('weight_cap') or 50
    overload = max(0, total_weight - cap)

    spd = base['spd'] + bonus.get('spd', 0) + eq.get('spd', 0) + ab.get('spd_mod', 0)
    spd -= int(eq_weight / 8)
    spd -= int(overload / 5)
    spd = max(1, spd)

    return {
        "atk": atk, "def": dfn, "mdef": mdef, "mag": mag, "spd": spd,
        "hp_bonus": prof_b.get('hp_bonus', 0),
        "eq_weight": eq_weight, "inv_weight": inv_weight,
        "total_weight": total_weight, "weight_cap": cap,
        "overload": overload,
        "dodge": ab.get('dodge', 0), "ignore_death": ab.get('ignore_death', 0),
    }


