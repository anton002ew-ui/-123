async def _do_raid(target, now):
    biome = get_biome_at(target["x"], target["y"])
    mob_pool = get_monsters_by_biome(biome)
    if not mob_pool: return None
    if random.random() < 0.15:
        bp = get_bosses_by_biome(biome)
        if bp: attacker_name = random.choice(bp); count = 1
        else: attacker_name = random.choice(mob_pool); count = random.randint(5, 10)
    else:
        attacker_name = random.choice(mob_pool); count = random.randint(3, 8)
    base_mob = MONSTER_TYPES.get(attacker_name, MONSTER_TYPES["Гоблин"])
    mm = 1.8 if base_mob.get("is_boss") else 1.0
    ap = int((base_mob["atk"] + base_mob["hp"] // 4) * count * mm)

    async with aiosqlite.connect(DB_PATH) as db:
        db.row_factory = aiosqlite.Row
        async with db.execute("SELECT * FROM npcs WHERE home_settlement=?", (target["name"],)) as cur:
            local = [dict(r) for r in await cur.fetchall()]
    guards = [n for n in local if n['role'] == "guard" and n['status'] == 'in_city']
    advs = [n for n in local if n['role'] == "adventurer" and n['status'] == 'in_city']

    players_near = []
    async with aiosqlite.connect(DB_PATH) as db:
        db.row_factory = aiosqlite.Row
        async with db.execute("SELECT * FROM players WHERE is_alive=1") as cur:
            for r in await cur.fetchall():
                p = dict(r)
                if p.get('is_afk') == 1: continue
                if p.get('is_abandoned_spirit') == 1: continue
                if p.get('is_sleeping') == 1: continue
                if p.get('in_jail') == 1: continue
                d = ((p.get('player_x', 100) - target["x"]) ** 2 +
                     (p.get('player_y', 100) - target["y"]) ** 2) ** 0.5
                if d <= 10: players_near.append(p)

    gp = sum(n['atk'] + n['def'] + n['level'] * 3 for n in guards)
    app = sum(n['atk'] + n['def'] + n['level'] * 5 for n in advs)
    pp = sum(p['level'] * 8 + p['hp'] // 4 for p in players_near)
    bd = {"city": 30, "village": 8, "ruins": 2}[target["type"]]
    dp = gp + app + pp + bd

    if ap > dp * 1.2:
        result = "raid_success"; emoji = "🔥"; text = "Мобы прорвались!"
    elif ap < dp * 0.8:
        result = "defended"; emoji = "🛡"; text = "Защитники отбились."
    else:
        result = "partial"; emoji = "⚔️"; text = "Ничья."

    killed = []; killed_masters = []; king_killed = False
    if result == "raid_success":
        if target["type"] == "city" and random.random() < 0.20:
            async with aiosqlite.connect(DB_PATH) as db:
                db.row_factory = aiosqlite.Row
                async with db.execute("SELECT * FROM npcs WHERE home_settlement=? AND is_state=1",
                                     (target["name"],)) as cur:
                    king = await cur.fetchone()
            if king:
                await kill_king(target["name"],
                                reason=f"пал при нападении {attacker_name} ×{count}")
                king_killed = True
        k = min(len(guards), random.randint(1, 3))
        for g in guards[:k]:
            killed.append(g['name'])
            if g.get('profession') and (g.get('mastery') or 0) > 0:
                await kill_master(g['id'], reason=f"погиб против {attacker_name}")
                killed_masters.append(g['name'])
        if guards:
            async with aiosqlite.connect(DB_PATH) as db:
                await db.execute("DELETE FROM npcs WHERE id IN ({})".format(",".join("?"*len(guards[:k]))),
                                 [g['id'] for g in guards[:k]])
                await db.commit()

    for p in players_near:
        if result == "raid_success":
            dmg = int(p['max_hp'] * 0.15); nh = max(1, p['hp'] - dmg)
            await db_save_player({**p, "hp": nh})
            await change_city_reputation(p['discord_id'], target["name"], -2)
        elif result == "defended":
            await change_city_reputation(p['discord_id'], target["name"], +5)
            await give_gold(p['discord_id'], 50, f"защита {target['name']}")
        elif result == "partial":
            await change_city_reputation(p['discord_id'], target["name"], +2)

    await register_settlement_raid(target["name"], result == "raid_success")
    async with aiosqlite.connect(DB_PATH) as db:
        if target["type"] == "city":
            await db.execute("UPDATE settlements SET last_raid_at=? WHERE name=?",
                             (now.isoformat(), target["name"]))
        elif target["type"] == "village":
            await db.execute("UPDATE settlements SET last_village_raid_at=? WHERE name=?",
                             (now.isoformat(), target["name"]))
        await db.execute("""INSERT INTO world_events
            (event_type,target_name,target_x,target_y,biome,monster_name,monster_count,
             attacker_power,defender_power,result,active)
            VALUES (?,?,?,?,?,?,?,?,?,?,1)""",
            ("settlement_attack", target["name"], target["x"], target["y"], biome,
             attacker_name, count, ap, dp, result))
        await db.commit()

    log = (f"{emoji} **Нападение на {target['name']}**\n👹 {attacker_name} ×{count} (сила {ap})\n"
           f"🛡 Защитники: {len(guards)}+{len(advs)}+{len(players_near)} (сила {dp})\n")
    if killed: log += f"💀 Погибли: {', '.join(killed)}\n"
    if king_killed: log += f"👑 Правитель пал!\n"
    if killed_masters: log += f"⚰️ Мастера: {', '.join(killed_masters)}\n"
    log += f"➡️ {text}"
    await db_log_event(log)
    return {"target": target, "monster": attacker_name, "count": count, "result": result}


async def simulate_city_attack():
    now = datetime.utcnow()
    cities = []
    for name, (x, y) in CITY_COORDS.items():
        s = await get_settlement(name)
        if not s: continue
        last = s.get('last_raid_at')
        if last:
            try:
                left_h = (now - datetime.fromisoformat(last)).total_seconds() / 3600
                if left_h < CITY_RAID_INTERVAL_H: continue
            except: pass
        blocked, _ = await is_settlement_blocked(name)
        if blocked: continue
        cities.append({"name": name, "x": x, "y": y, "type": "city"})
    if not cities: return None
    if random.random() > CITY_RAID_CHANCE: return None
    target = random.choice(cities)
    return await _do_raid(target, now)


