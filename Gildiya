async def spawn_new_master(prof=None, city_hint=None):
    all_profs = list(PROFESSION_BUFFS.keys())
    if prof:
        if await count_masters_for_profession(prof) >= MAX_MASTERS_PER_PROFESSION: return None
    else:
        counts = []
        for p in all_profs:
            c = await count_masters_for_profession(p)
            if c < MAX_MASTERS_PER_PROFESSION: counts.append((c, p))
        if not counts: return None
        counts.sort(); prof = counts[0][1]
    ss = await get_all_settlements(); cities = [s for s in ss if s['type'] in ("city","village")]
    if not cities: return None
    if city_hint:
        matches = [s for s in cities if s['name'] == city_hint]
        city = matches[0] if matches else random.choice(cities)
    else: city = random.choice(cities)
    name = generate_master_name(prof); lvl = random.randint(6,12)
    st = build_npc_stats("craftsman", lvl); role = "craftsman"
    cat = PROFESSION_BUFFS.get(prof, {}).get('type')
    if cat == "magic": role = "priest"
    elif cat == "trade": role = "merchant"
    elif cat == "combat": role = "adventurer"
    elif cat == "social": role = "citizen"
    async with aiosqlite.connect(DB_PATH) as db:
        cur = await db.execute("""INSERT INTO npcs
            (name,role,level,hp,max_hp,atk,def,mdef,spd,intl,x,y,home_settlement,status,gold,profession,mastery)
            VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)""",
            (name, role, lvl, st["hp"], st["max_hp"], st["atk"], st["def"], st["mdef"],
             st["spd"], st["intl"], city['x'], city['y'], city['name'], "in_city", st["gold"],
             prof, max(1, lvl//3)))
        await db.commit(); nid = cur.lastrowid
    await db_log_event(f"🎓 Новый мастер: **{name}** в {city['name']}.")
    return await get_npc(nid)

async def ensure_all_masters_exist():
    all_profs = list(PROFESSION_BUFFS.keys()); created = 0
    for prof in all_profs:
        c = await count_masters_for_profession(prof)
        while c < MAX_MASTERS_PER_PROFESSION:
            m = await spawn_new_master(prof)
            if not m: break
            created += 1; c += 1
            if created >= 5: break
        if created >= 5: break
    if created: print(f"[MASTERS] +{created}")
    return created

