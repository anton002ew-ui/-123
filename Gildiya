async def fail_quest(quest):
    qid = quest['id']
    penalty = quest['penalty_gold'] or 0
    group_id = quest.get('group_id')

    if group_id:
        g = await db_get_quest_group(group_id)
        members = json.loads(g['members'] or '[]') if g else [quest['taken_by']]
    else:
        members = [quest['taken_by']]

    per_person = penalty // len(members) if members else 0
    report_lines = [f"💀 **Заказ #{qid} провален** (группа из {len(members)} чел.)\n"]

    for uid in members:
        rep = await apply_quest_penalty(uid, per_person, f"провал #{qid}")
        src_city = quest.get('target_name') or ""
        if src_city: await change_city_reputation(uid, src_city, -5)
        if quest.get('source_npc_id'):
            await change_npc_reputation(uid, quest['source_npc_id'], -8)
        pp = await db_get_player(uid)
        if pp:
            await db_save_player({**pp, "quests_failed": (pp.get('quests_failed',0) or 0) + 1})
        pl = await db_get_player(uid)
        name = pl['name'] if pl else f"ID {uid}"
        items_str = ", ".join(rep['items_taken']) if rep['items_taken'] else "—"
        report_lines.append(
            f"• **{name}** — взято {rep['gold_taken']}💰, изъято: {items_str}"
            + (f", сдача +{rep['change_given']}💰" if rep['change_given'] else "")
            + (f", долг {rep['remaining_penalty']}💰" if rep['remaining_penalty'] else ""))

    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("UPDATE quest_board SET status='failed' WHERE id=?", (qid,))
        if group_id:
            await db.execute("DELETE FROM quest_groups WHERE id=?", (group_id,))
        await db.commit()

    await db_log_event("\n".join(report_lines))
    try:
        ch = bot.get_channel(CH_QUESTS)
        if ch:
            mentions = " ".join(f"<@{m}>" for m in members)
            await ch.send(f"{mentions}\n\n" + "\n".join(report_lines))
    except: pass
    return {"members": len(members), "per_person": per_person}


async def _complete_quest_group_or_solo(q, thread_id=None):
    qid = q['id']
    taken_by = q['taken_by']
