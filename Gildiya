def monster_loot_pool(monster_type, biome):
    name_l = monster_type.lower()
    pool = []
    if any(k in name_l for k in ["гоблин","бандит","пират","орк","скелет","мумия","ящер",
                                  "кентавр","сатир","тэнгу","минотавр","циклоп"]):
        pool += [i for i, it in ITEMS.items() if it['cat'] == "weapon" and it.get('req',1) <= 8]
        pool += [i for i, it in ITEMS.items() if it['cat'] == "armor" and it.get('req',1) <= 8]
    if any(k in name_l for k in ["кицунэ","джинн","суккуб","элементаль","фантазм","лич","маг","сфинкс"]):
        pool += [i for i, it in ITEMS.items() if it['cat'] in ("scroll","amulet")]
        pool += [i for i, it in ITEMS.items() if it['cat'] == "weapon" and it.get("mag",0) >= 3]
    if any(k in name_l for k in ["волк","медведь","рысь","кабан","кот","собака","паук","змея",
                                  "скорпион","ящер","тигр","олень"]):
        pool += ["Кожа","Толстая кожа","Кости","Чешуя"]
    if any(k in name_l for k in ["дракон","виверна","кирин","гидра"]):
        pool += ["Драконья кожа","Драконьи кости","Драконья чешуя","Алмаз","Рубин","Сапфир"]
    if MONSTER_TYPES.get(monster_type, {}).get('is_boss'):
        pool += [i for i, it in ITEMS.items() if it.get('req',1) >= 7]
        pool += ["Кристалл","Демоническая эссенция","Ангельская слеза"]
    BIOME_ITEMS = {
        "forest":["Дубовая древесина","Лунный камень"],
        "mountains":["Железный слиток","Стальной слиток","Мифриловый слиток"],
        "volcano":["Огненный кристалл","Пепельная роза","Угольный лотос"],
        "desert":["Соляная трава","Кристалл","Золотое кольцо"],
        "swamp":["Тёмная травинка","Костяной лишайник","Болотный корень"],
        "jungle":["Кровавый стебель","Ядовитый цветок","Лиана жизни"],
        "coast":["Жемчужная тина","Морская водоросль","Соляной куст"],
        "plains":["Полевой клевер","Ромашка","Кожа"],
    }
    pool += BIOME_ITEMS.get(biome, [])
    return list(set(pool))


def roll_loot(monster_type, monster_level, source="normal", biome="plains", monster_equipment=None):
    result = {"gold":0, "items":[]}
    m = MONSTER_TYPES.get(monster_type, {})
    base_gold = int((m.get("hp",10)*0.3 + m.get("atk",3)*2) * (1 + monster_level*0.15))
    if source == "boss": base_gold *= 5
    if source == "elite": base_gold *= 2
    if source == "dungeon": base_gold = int(base_gold * 1.2)
    if source == "ruins": base_gold = int(base_gold * 1.3)
    roll = random.random()
    if roll < 0.30 and source != "boss": result["gold"] = 0
    elif roll > 0.90: result["gold"] = int(base_gold * random.uniform(1.8, 3.0))
    else: result["gold"] = int(base_gold * random.uniform(0.7, 1.3))
    chance = LOOT_CHANCE.get(source, LOOT_CHANCE["normal"])
    pool = monster_loot_pool(monster_type, biome)
    if random.random() < chance and pool:
        loot = roll_item_from_pool(pool, source)
        if loot: result["items"].append(loot)
    if monster_equipment:
        for eq in monster_equipment:
            result["items"].append({"item_id":eq["item_id"],"rarity":eq.get("rarity",0),
                                    "quality":eq.get("quality",1),"from_equipment":True})
    if source == "boss" and pool:
        loot2 = roll_item_from_pool(pool, "boss")
        if loot2: result["items"].append(loot2)
    mat_pool = [i for i in pool if ITEMS.get(i, {}).get('cat') == "material"]
    if mat_pool and random.random() < 0.5:
        iid = random.choice(mat_pool); cnt = random.randint(1,3)
        result["items"].append({"item_id":iid, "count":cnt, "rarity":0, "quality":1})
    return result


