                          "death_time":datetime.utcnow().isoformat(),
                          "death_cause": reason})
    await db_add_corpse(player_id, p['name'], p['race'], p['level'],
                        datetime.utcnow().isoformat())
    try:
        for g in bot.guilds:
            m = g.get_member(player_id)
            if m:
                await remove_race_role_and_nick(g, m, p['race'])
                try: await cleanup_player_death(g, player_id)
                except: pass
    except Exception as e: print(f"[EXECUTE ERR] {e}")
