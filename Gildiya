async def open_shop(interaction, merchant):
    p = await db_get_player(interaction.user.id)
    if not p: return
    stock = json.loads(merchant['stock'] or '[]')
    mt = MERCHANT_TYPES.get(merchant['merchant_type'], {})
    reps = json.loads(p.get('reputation') or '{}')
    rep = reps.get(str(merchant['id']), 0)
    async with aiosqlite.connect(DB_PATH) as db:
        db.row_factory = aiosqlite.Row
        async with db.execute("SELECT * FROM merchant_gold WHERE merchant_id=? AND player_id=?",
                             (merchant['id'], interaction.user.id)) as cur:
            mg = await cur.fetchone()
    if not mg:
        base = merchant.get('base_gold') or 500
        async with aiosqlite.connect(DB_PATH) as db:
            await db.execute("""INSERT INTO merchant_gold
                (merchant_id,player_id,gold,last_refill) VALUES (?,?,?,?)""",
                (merchant['id'], interaction.user.id, base, datetime.utcnow().isoformat()))
            await db.commit()
        merchant_gold = base
    else:
        merchant_gold = mg['gold']
    lines = []
    for i, s in enumerate(stock[:15]):
        iid = s['item']
        price = calc_price(iid, merchant, p, is_sell=False)
        q = f" ⭐×{s['quality']}" if s.get('quality',1) > 1 else ""
        lines.append(f"`{i+1}.` **{iid}**{q} — {price}💰 (×{s['count']})")
    embed = discord.Embed(title=f"{mt.get('name','🛒')} {merchant['name']}",
        description="\n".join(lines) or "Пусто", color=0xffd700)
    embed.add_field(name="💰 Ваше", value=f"{p.get('gold',0)}", inline=True)
    embed.add_field(name="💵 У торговца", value=f"{merchant_gold}", inline=True)
    embed.add_field(name="💬 Реп.", value=f"{reputation_title(rep)}", inline=True)
    await interaction.response.send_message(embed=embed,
        view=ShopView(merchant, stock, interaction.user.id), ephemeral=True)


class ShopView(ui.View):
    def __init__(self, merchant, stock, pid):
        super().__init__(timeout=600)
        self.merchant = merchant; self.stock = stock; self.pid = pid
        opts = [discord.SelectOption(label=f"{s['item'][:60]} (×{s['count']})", value=str(i))
                for i, s in enumerate(stock[:25])]
        if opts:
            sel = ui.Select(placeholder="🛍 Купить...", options=opts, row=0)
            sel.callback = self._on_buy; self.add_item(sel)
        b = ui.Button(label="💱 Продать", style=discord.ButtonStyle.primary, row=1)
        b.callback = self._on_sell; self.add_item(b)
    async def _on_buy(self, interaction):
        idx = int(interaction.data['values'][0])
        item = self.stock[idx]
        p = await db_get_player(interaction.user.id)
        iid = item['item']
        price = calc_price(iid, self.merchant, p, is_sell=False)
        if (p.get('gold') or 0) < price:
            await interaction.response.send_message(f"❌ Мало золота ({price}💰).",
                                                    ephemeral=True); return
        await add_inventory_item(interaction.user.id, iid, 1, item.get('quality', 1))
        await give_gold(interaction.user.id, -price, f"покупка {iid}")
        async with aiosqlite.connect(DB_PATH) as db:
            await db.execute("""INSERT INTO trades
                (player_id,npc_id,item_id,count,total_gold,trade_type)
                VALUES (?,?,?,?,?,'buy')""",
                (interaction.user.id, self.merchant['id'], iid, 1, price))
            await db.commit()
        await change_npc_reputation(interaction.user.id, self.merchant['id'], 1)
        await add_profession_xp(interaction.user.id, "Коробейник", 5)
        await interaction.response.send_message(f"✅ Куплено: **{iid}** за {price}💰.",
                                                ephemeral=True)
    async def _on_sell(self, interaction):
