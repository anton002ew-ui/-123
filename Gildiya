def xp_needed(lvl): return 100 + (lvl - 1) * 50
def is_night(): h = datetime.utcnow().hour; return h >= 20 or h < 6

async def process_levelups(row):
    if not row: return None, 0
    p = dict(row); g = 0
    while p['level'] < MAX_LEVEL and p['xp'] >= xp_needed(p['level']):
        p['xp'] -= xp_needed(p['level']); p['level'] += 1
        p['stat_points'] = p.get('stat_points',0)+LEVEL_STAT_POINTS
        p['max_hp'] += LEVEL_HP_BONUS
        p['hp'] = min(p['hp']+LEVEL_HP_BONUS, p['max_hp']); g += 1
    if g > 0:
        await db_save_player(p)
        if p.get('stats_thread_id'):
            try:
                th = bot.get_channel(p['stats_thread_id'])
                if th:
                    np = await db_get_player(p['discord_id'])
                    await th.send(content=f"🎉 <@{p['discord_id']}> — **Ур. {np['level']}**!",
                                  embed=await build_stats_embed_async(np), view=StatButtonsView())
            except: pass
    return await db_get_player(p['discord_id']), g

async def add_xp_capped(row, amount):
    if amount <= 0: return 0, DAILY_XP_CAP
    p = dict(row); today = datetime.utcnow().strftime("%Y-%m-%d")
    if p.get('xp_today_date') != today: p['xp_today'] = 0; p['xp_today_date'] = today
    a = p.get('xp_today',0) or 0; rem = max(0, DAILY_XP_CAP-a); g = min(amount, rem)
    p['xp'] = p.get('xp',0)+g; p['xp_today'] = a+g
    await db_save_player(p); return g, rem-g


