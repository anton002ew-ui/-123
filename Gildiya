def _fmt_player_bio(p):
    try: profs = json.loads(p.get('professions') or '[]')
    except: profs = []
    if p.get('profession') and p['profession'] not in ("Нет","Новичок"):
        if p['profession'] not in profs: profs.insert(0, p['profession'])
    prof_str = ", ".join(profs[:3]) if profs else "нет"
    return (f"{p['name']}, {p['gender']}, {p['race']}, ур.{p['level']}. "
            f"Профессии: {prof_str}. HP {p['hp']}/{p['max_hp']}. "
            f"Голод {p['hunger']:.0f}/{p['max_hunger']:.0f}, жажда {p['thirst']:.0f}/{p['max_thirst']:.0f}. "
            f"Золото: {p.get('gold',0)}.")

def _fmt_world_state(p):
    px = p.get('player_x', 100) or 100
    py = p.get('player_y', 100) or 100
    biome = get_biome_at(px, py)
    loc = p.get('location') or "Дикая местность"
    in_city = p.get('in_city', 1) == 1
    night = is_night()
    hour = datetime.utcnow().hour
    time_str = "🌙 ночь" if night else "☀️ день"
    place = f"город {loc}" if in_city else f"{get_biome_name(biome)}"
    return f"Локация: {place}. Время: {time_str} ({hour:02d}:00 UTC)."

def _fmt_relations(p, loc):
    city_rep = get_city_reputation(p, loc)
    city_title = reputation_title(city_rep)
    return f"Репутация в {loc}: {city_rep:+d} ({city_title})."

def _fmt_abilities(p):
    eff = parse_active_effects(p)
    if not eff: return "нет активных эффектов"
    return ", ".join(k for k in eff.keys())


async def _fetch_recent_history(player_id, limit=15):
    async with aiosqlite.connect(DB_PATH) as db:
        db.row_factory = aiosqlite.Row
        async with db.execute("""SELECT action_text, bot_response FROM actions
            WHERE discord_id=? ORDER BY id DESC LIMIT ?""", (player_id, limit)) as cur:
            rows = [dict(r) for r in await cur.fetchall()]
    rows.reverse()
    lines = []
    for r in rows:
        a = (r['action_text'] or "")[:100]
        b = (r['bot_response'] or "")[:150]
        if a and b:
            lines.append(f"• Игрок: {a}\n  Мастер: {b}")
    return "\n".join(lines) if lines else "*Действий ещё не было.*"


