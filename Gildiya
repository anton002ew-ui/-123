def build_quest_embed(quest, idx, total):
    """Красивый embed заказа для доски."""
    kind = quest.get('quest_kind', 'monster')
    styles = {
        "monster":  ("📜", "Красный", 0xc53030),
        "herb":     ("🌿", "Зелёный", 0x2ecc71),
        "delivery": ("📦", "Оранжевый", 0xd69e2e),
        "state":    ("👑", "Золотой",  0xd4af37),
    }
    icon, kind_name, color = styles.get(kind, ("📜", "—", 0x2f855a))
    embed = discord.Embed(
        title=f"{icon} Заказ #{quest['id']} — {quest['title']}",
        description=quest.get('description', '') or "",
        color=color)
    embed.add_field(name="💰 Награда", value=f"**{quest['reward_gold']}** золота", inline=True)
    embed.add_field(name="⚠️ Штраф", value=f"**{quest['penalty_gold']}**", inline=True)
    if quest.get('taken_at'):
        try:
            exp = datetime.fromisoformat(quest['taken_at']) + timedelta(hours=24)
            left = (exp - datetime.utcnow()).total_seconds() // 3600
            embed.add_field(name="⏱️ Срок", value=f"{int(left)} ч", inline=True)
        except: pass
    embed.add_field(name="👤 Заказчик", value=quest.get('source_npc_name') or "—", inline=False)
    embed.set_footer(text=f"Тип: {kind_name} · {idx+1}/{total}")
    if quest.get('image_url'):
        embed.set_thumbnail(url=quest['image_url'])
    return embed


