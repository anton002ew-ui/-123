async def panel_flee(interaction, thread_id):
    p = await db_get_player(interaction.user.id)
    if not p: return
    sess = await db_get_dungeon_session(thread_id)
    if sess:
        if sess['room'] == 4:
            await interaction.response.send_message("🚪 Босс не отпустит.", ephemeral=True); return
        await interaction.response.defer()
        ab_bonus = get_ability_bonus(p)
        sb = (p.get('spd',5) or 5)//2 + ab_bonus.get('spd_mod',0)
        res, _, _ = await animate_dice_roll(interaction.channel, 20, prefix="Побег",
                                             target=12, bonus=sb)
        ok = (res + sb) >= 12
        if ok:
            await db_set_dungeon_respawn_timer(sess['dungeon_id'], days=4)
            await db_set_dungeon_cooldown(interaction.user.id, hours=2)
            await db_delete_dungeon_session(thread_id)
            await db_delete_gameplay_thread(thread_id)
            await interaction.channel.send("🏃 **Вырвались.** КД 2ч. Мобы вернутся через 4 дня.")
            await asyncio.sleep(3)
            try: await interaction.channel.edit(archived=True, locked=True)
            except: pass
        else:
            dmg = int(p['max_hp'] * 0.15); nh = max(1, p['hp'] - dmg)
            await db_save_player({**dict(p), "hp": nh})
            await interaction.channel.send(f"💥 Провал. Урон: {dmg} (HP: {nh})")
        return
    t = await db_get_gameplay_thread(thread_id)
    if not t or not t['is_battle']:
        await interaction.response.send_message("ℹ️ Не бой.", ephemeral=True); return
    ab_bonus = get_ability_bonus(p)
    sb = (p.get('spd',5) or 5)//2 + ab_bonus.get('spd_mod',0)
    res, _, _ = await animate_dice_roll(interaction.channel, 20, prefix="Побег",
                                         target=12, bonus=sb)
    if (res + sb) >= 12:
        await db_save_gameplay_thread(thread_id, t['owner_id'],
            json.loads(t['participants'] or '[]'), is_battle=0,
            location=t['location'], in_city=t['in_city'],
            story_summary=(t['story_summary'] or "") + " Сбежал.")
        await interaction.channel.send("🏃 **Успешный побег!**")
    else:
        dmg = int(p['max_hp'] * 0.10); nh = max(1, p['hp'] - dmg)
        await db_save_player({**dict(p), "hp": nh})
        await interaction.channel.send(f"💥 Провал. Урон: {dmg}")


