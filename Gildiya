async def send_death_dm(player_id, cause="неизвестно"):
    p = await db_get_player(player_id)
    if not p:
        print(f"[DEATH DM] Игрок {player_id} не найден"); return False
    lived_str = "—"
    try:
        if p.get('created_at'):
            created = datetime.fromisoformat(p['created_at'])
            died = datetime.utcnow()
            delta = died - created
            days = delta.days
            hours = delta.seconds // 3600
            minutes = (delta.seconds % 3600) // 60
            if days > 0: lived_str = f"**{days}** дн. **{hours}** ч. **{minutes}** мин."
            elif hours > 0: lived_str = f"**{hours}** ч. **{minutes}** мин."
