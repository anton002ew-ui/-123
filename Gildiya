async def _report_crime_to_guards(player_id, city, witness_name, severity,
                                    channel, caught_in_act=False):
    p = await db_get_player(player_id)
    if not p: return
    severity = await apply_kindness_reduction(player_id, city, severity)
    async with aiosqlite.connect(DB_PATH) as db:
        db.row_factory = aiosqlite.Row
        async with db.execute("""SELECT * FROM npcs
            WHERE home_settlement=? AND role='guard' AND status='in_city'
            ORDER BY level DESC LIMIT 1""", (city,)) as cur:
            guard = await cur.fetchone()
    guard_name = guard['name'] if guard else "городская стража"

    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("""INSERT INTO crimes
            (player_id, city, kind, description, severity, witnesses, reported)
            VALUES (?,?,?,?,?,?,1)""",
            (player_id, city, "theft", f"Кража (свидетель: {witness_name})", severity, 1))
        await db.commit()

    await apply_punishment(player_id, city, severity, caught_in_act, witness_name, channel)


