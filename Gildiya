def generate_room_pack(biome, room_num, pl, pc=1):
    mp = get_monsters_by_biome(biome) or ["Гоблин","Крыса"]
    cnt = 2 if room_num == 1 else 3
    mult = 1.0 if room_num == 1 else 1.3
    pack = []; th = 0; ta = 0; td = 0
    for _ in range(cnt):
        mt = random.choice(mp); base = MONSTER_TYPES.get(mt, MONSTER_TYPES["Гоблин"])
        lf = 1 + max(0, pl-1) * 0.12
        hp = int(base["hp"]*lf*mult); atk = int(base["atk"]*lf*mult); dfn = int(base["def"]*lf*mult)
        pack.append({"type":mt,"hp":hp,"atk":atk,"def":dfn})
        th += hp; ta += atk; td += dfn
    return {"count":cnt,"members":pack,"hp":th,"max_hp":th,"atk":ta//max(1,cnt),
            "def":td//max(1,cnt),"name":", ".join(set(m["type"] for m in pack)),"room":room_num,
            "is_magic": any(is_magic_monster(m["type"]) for m in pack)}


