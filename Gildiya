class PlayerPanelView(ui.View):
    def __init__(self, player_id, thread_id, context):
        super().__init__(timeout=None)
        self.player_id = player_id
        self.thread_id = thread_id
        for i, btn_key in enumerate(context["buttons"]):
            if btn_key not in BUTTON_DEFS: continue
            label, style, cid = BUTTON_DEFS[btn_key]
            row = min(4, i // 5)
            b = ui.Button(label=label, style=style,
                          custom_id=f"{cid}_{thread_id}_{player_id}", row=row)
            b.callback = self._make_handler(btn_key)
            self.add_item(b)

    def _make_handler(self, key):
        async def handler(interaction):
            if interaction.user.id != self.player_id:
                await interaction.response.send_message("❌ Чужая панель.", ephemeral=True); return
            await dispatch_panel_action(interaction, key, self.thread_id)
        return handler


async def build_player_panel(player_id, thread_id):
    ctx = await get_player_context(player_id, thread_id)
    p = ctx["p"]
    if not p: return None, None
    color = EMBED_COLORS["info"]
    if p.get('is_afk') == 1: color = EMBED_COLORS["shadow"]
    elif p.get('is_abandoned_spirit') == 1: color = EMBED_COLORS["shadow"]
    elif p.get('in_spirit_form') == 1: color = EMBED_COLORS["group"]
    elif p.get('in_jail') == 1: color = EMBED_COLORS["danger"]
    elif p.get('is_sleeping') == 1: color = EMBED_COLORS["frost"]

    embed = discord.Embed(title=f"🎮 Управление — {p['name']}",
        description=f"{context_location_text(ctx)}\n*Кнопки меняются по ситуации.*",
        color=color)
    hp_txt = f"{p['hp']}/{p['max_hp']}"
    if p.get('is_abandoned_spirit') == 1: hp_txt = "🌫️ **Брошен**"
    elif p.get('in_spirit_form') == 1: hp_txt = "👻 **Дух**"
    elif p.get('is_sleeping') == 1: hp_txt = "😴 **Спит**"
    embed.add_field(name="❤️ HP", value=hp_txt, inline=True)
    embed.add_field(name="💰 Золото", value=f"{p.get('gold',0)}", inline=True)
    embed.add_field(name="🍖 Голод", value=f"{p['hunger']:.0f}", inline=True)
    embed.add_field(name="💧 Жажда", value=f"{p['thirst']:.0f}", inline=True)
    embed.add_field(name="😴 Сон", value=f"{p['sleep']:.0f}", inline=True)
    embed.add_field(name="⭐ Ур.", value=f"{p['level']}", inline=True)
    if ctx["in_battle"]:
        t = await db_get_gameplay_thread(thread_id)
        if t:
            embed.add_field(name=f"👹 {t['enemy_name']}",
                value=f"❤️ {t['enemy_hp']}/{t['enemy_max_hp']} · ур.{t['enemy_level']}",
                inline=False)
    view = PlayerPanelView(player_id, thread_id, ctx)
    return embed, view


async def refresh_player_panel(thread, player_id):
    try:
        embed, view = await build_player_panel(player_id, thread.id)
        if not embed: return
        t = await db_get_gameplay_thread(thread.id)
        msg_id = t.get('panel_message_id') if t else None
        if msg_id:
            try:
                m = await thread.fetch_message(msg_id)
                await m.edit(embed=embed, view=view); return
            except: pass
        m = await thread.send(embed=embed, view=view)
        if t:
            async with aiosqlite.connect(DB_PATH) as db:
                await db.execute("""UPDATE gameplay_threads SET panel_message_id=?,
                                    panel_updated_at=? WHERE thread_id=?""",
                    (m.id, datetime.utcnow().isoformat(), thread.id))
                await db.commit()
    except Exception as e: print(f"[PANEL REFRESH] {e}")


