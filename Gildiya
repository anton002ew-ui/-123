async def attack_fantasm_spirit(interaction, target_id):
    p = await db_get_player(interaction.user.id)
    tp = await db_get_player(target_id)
    if not p or not tp: return
    stats = await get_player_combat_stats(p)
    await interaction.response.defer()
    res, _, _ = await animate_dice_roll(
        interaction.channel, 20, prefix="Магический удар",
        target=10, bonus=stats['mag'] // 3)
    if res + stats['mag'] // 3 >= 10:
        raw = stats['mag'] - stats['mdef'] * 0.5
        dmg = max(1, int(raw))
        new_hp = max(0, tp['hp'] - dmg)
        await db_add_contribution(interaction.channel.id, interaction.user.id, damage=dmg)
        await interaction.channel.send(
            f"🔮 **{p['name']}** ударил дух **{tp['name']}** на **{dmg}** "
            f"(MAG {stats['mag']} vs MDEF {stats['mdef']})\n"
            f"👻 Дух: **{new_hp}/{tp['max_hp']}**")
        if new_hp <= 0:
            if tp.get('body_dead') == 1 or (tp.get('body_hp') or 0) <= 0:
                await db_save_player({**tp,
                    "hp": 0,
                    "is_abandoned_spirit": 1,
                    "abandoned_since": datetime.utcnow().isoformat(),
                    "in_spirit_form": 1,
                    "body_dead": 1})
                await interaction.channel.send(embed=discord.Embed(
                    title="🌫️ Брошенный дух",
                    description=(f"**{tp['name']}** истощился. Тело мертво, силы на нуле.\n\n"
                                 f"⏱️ **24 часа**: вселение или изгнание"),
                    color=0x4a5568))
                await db_log_event(f"🌫️ Фантазм **{tp['name']}** стал **брошенным духом**.")
            else:
                await db_save_player({**tp,
                    "in_spirit_form": 0,
                    "hp": max(1, (tp.get('body_hp') or 1) // 2),
                    "body_hp": 0, "body_max_hp": 0})
                await interaction.channel.send(
                    f"🌀 **Дух {tp['name']} отброшен в тело!** "
                    f"HP {max(1, (tp.get('body_hp') or 1) // 2)}.")
        else:
            await db_save_player({**tp, "hp": new_hp})
    else:
        await interaction.channel.send(f"❌ **{p['name']}** промахнулся по духу.")


