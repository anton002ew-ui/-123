async def equip_item(player_id, inv_id, target_slot):
    async with aiosqlite.connect(DB_PATH) as db:
        db.row_factory = aiosqlite.Row
        async with db.execute("SELECT * FROM inventory WHERE id=? AND player_id=?", (inv_id, player_id)) as cur:
            inv = await cur.fetchone()
    if not inv: return False, "Предмет не найден."
    inv = dict(inv)
    item = ITEMS.get(inv['item_id'])
    if not item: return False, "Неизвестный предмет."
    compat = SLOT_COMPAT.get(target_slot, [])
    item_slot = item.get('equip_slot')
    if item_slot not in compat and item_slot != target_slot:
        if not (item_slot == "hands" and target_slot in ("hands_left","hands_right")) \
           and not (item_slot == "feet" and target_slot in ("feet_left","feet_right")):
            return False, f"Нельзя надеть **{inv['item_id']}** сюда."
    req = item.get('req', 1)
    p = await db_get_player(player_id)
    if p and p['level'] < req: return False, f"Нужен уровень {req}+."
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("UPDATE inventory SET equipped_slot=NULL WHERE player_id=? AND equipped_slot=?",
                         (player_id, target_slot))
        await db.execute("UPDATE inventory SET equipped_slot=? WHERE id=?", (target_slot, inv_id))
        await db.commit()
    return True, f"✅ Надето: **{inv['item_id']}** → {SLOT_NAMES.get(target_slot, target_slot)}"

async def unequip_slot(player_id, slot):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("UPDATE inventory SET equipped_slot=NULL WHERE player_id=? AND equipped_slot=?",
                         (player_id, slot)); await db.commit()
    return True, f"Снято: {SLOT_NAMES.get(slot, slot)}"

def get_equipment_bonuses_from_items(equipped):
    total = {"hp":0,"atk":0,"def":0,"mdef":0,"mag":0,"spd":0,"intl":0,"luck":0,"crit":0,"dmg":0}
    for slot, inv in equipped.items():
        rolled = json.loads(inv.get('rolled_stats') or '{}')
        for k, v in rolled.items():
            if k in total: total[k] += v
        if inv.get('rolled_dmg'): total["atk"] += inv["rolled_dmg"]
    return total

