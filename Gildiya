async def apply_punishment(player_id, city, severity, caught_in_act, witness_name, channel):
    p = await db_get_player(player_id)
    if not p: return
    brands_in_city = await get_brand_count_in_city(player_id, city)
    if brands_in_city >= 2 and severity >= 3:
        await execute_for_brands(player_id, city, channel)
        return
    decision = await ai_choose_punishment(p['name'], severity, caught_in_act,
                                            witness_name, brands_in_city)
    pun_type = decision.get('type', 'rods')
    if pun_type == "execution":
        await execute_for_brands(player_id, city, channel); return

    # ===== ПОЗОРНЫЙ СТОЛБ =====
    if pun_type == "pillory":
        duration, unit, reason = await ai_calculate_debuff_duration(
            p['name'], city, severity, "pillory", brands_in_city)
        hours = duration
        until = (datetime.utcnow() + timedelta(hours=hours)).isoformat()
        await db_save_player({**p, "rod_until": until, "rod_debuff_active": 1})
        await add_active_effect(p, f"pillory_{city}", hours * 3600, {
            "atk_flat": -PUNISHMENTS['pillory']['debuff']['atk_penalty']})
        await change_city_reputation(player_id, city,
            -PUNISHMENTS['pillory']['debuff']['reputation_penalty'])
        embed = discord.Embed(
            title="⛓️ Позорный столб",
            description=(f"**{decision.get('text', 'Публичное наказание')}**\n\n"
                         f"Тебя привязали к столбу на центральной площади **{city}**.\n"
                         f"Толпа собралась поглазеть.\n\n"
                         f"⏱️ **{hours} ч** позора\n"
                         f"⚔️ **−{PUNISHMENTS['pillory']['debuff']['atk_penalty']} ATK**\n"
                         f"💬 **−{PUNISHMENTS['pillory']['debuff']['reputation_penalty']} реп**\n"
                         f"-# *{reason}*"),
            color=EMBED_COLORS["warning"])
        embed.set_footer(text=f"Клейм в городе: {brands_in_city}/2")
        await channel.send(embed=embed)
        await db_log_event(f"⛓️ **{p['name']}** у позорного столба в {city} ({hours}ч).")
        return

    # ===== РОЗГИ =====
    if pun_type == "rods":
        duration, unit, reason = await ai_calculate_debuff_duration(
            p['name'], city, severity, "rods", brands_in_city)
        hours = duration
        until = (datetime.utcnow() + timedelta(hours=hours)).isoformat()
        dmg = PUNISHMENTS['rods']['debuff']['hp_penalty'] * p['max_hp'] // 20
        new_hp = max(1, p['hp'] - dmg)
        await db_save_player({**p,
            "hp": new_hp, "rod_until": until, "rod_debuff_active": 1})
        await add_active_effect(p, f"rod_punish_{city}", hours * 3600, {
            "atk_flat": -PUNISHMENTS['rods']['debuff']['atk_penalty'],
            "spd_mod": -PUNISHMENTS['rods']['debuff']['spd_penalty']})
        await change_city_reputation(player_id, city,
            -PUNISHMENTS['rods']['debuff']['reputation_penalty'])
        embed = discord.Embed(
            title="🪵 Порка розгами",
            description=(f"**{decision.get('text', 'Порка на площади')}**\n\n"
                         f"Палач зачитывает приговор, розги свистят.\n"
                         f"Каждый удар отзывается жгучей болью.\n\n"
                         f"💔 Потеряно **{dmg}** HP (→ {new_hp}/{p['max_hp']})\n"
                         f"⚔️ **−{PUNISHMENTS['rods']['debuff']['atk_penalty']} ATK** на **{hours} ч**\n"
                         f"💨 **−{PUNISHMENTS['rods']['debuff']['spd_penalty']} SPD** на **{hours} ч**\n"
                         f"💬 **−{PUNISHMENTS['rods']['debuff']['reputation_penalty']} реп**\n"
                         f"-# *{reason}*"),
            color=EMBED_COLORS["warning"])
        embed.set_footer(text=f"Клейм в городе: {brands_in_city}/2")
        await channel.send(embed=embed)
        await db_log_event(f"🪵 **{p['name']}** выпорот в {city} ({hours}ч).")
        return

    # ===== ТЮРЬМА =====
    if pun_type == "jail":
        minutes = decision.get('minutes', 120)
        bail = decision.get('bail', 300)
        jail_until = (datetime.utcnow() + timedelta(minutes=minutes)).isoformat()
        async with aiosqlite.connect(DB_PATH) as db:
            await db.execute("""INSERT INTO jail
                (player_id, city, cell_number, reason, severity, sentence_minutes,
                 bail_price, jail_until, active)
                VALUES (?,?,?,?,?,?,?,?,1)""",
                (player_id, city, f"K-{random.randint(100,999)}",
                 decision.get('text', 'Арест'), severity, minutes, bail, jail_until))
            await db.commit()
        await change_city_reputation(player_id, city, -severity * 5)
        await db_save_player({**p,
            "location": f"Тюрьма {city}",
            "in_city": 0, "in_temple": 0, "in_jail": 1,
            "jail_until": jail_until, "jail_city": city,
            "near_temple": 0, "temple_name": None})
        embed = discord.Embed(
            title="🔒 Тюремное заключение",
            description=(f"**{decision.get('text', 'Арест')}**\n\n"
                         f"Тебя ведут в тюрьму **{city}**.\n"
                         f"Холодная камера, скрип решётки, тишина.\n\n"
                         f"⏱️ **{minutes} мин.** заключения\n"
                         f"💰 Залог: **{bail}** золота (`/bail`)\n"
                         f"✝️ Поручиться: `/deliver @игрок`\n"
                         f"💬 **−{severity*5} реп**"),
            color=EMBED_COLORS["danger"])
        embed.set_footer(text=f"Клейм в городе: {brands_in_city}/2")
        await channel.send(embed=embed)
        await db_log_event(f"🔒 **{p['name']}** арестован в {city} на {minutes} мин.")
        return

    # ===== КЛЕЙМО =====
    if pun_type == "brand":
        duration_days, unit, reason = await ai_calculate_debuff_duration(
            p['name'], city, severity, "brand", brands_in_city)
        duration_hours = duration_days * 24
        await add_brand_to_city(player_id, city, decision.get('text', ''),
                                 severity, duration_hours)
        await add_active_effect(p, f"brand_{city}", duration_hours * 3600, {
            "regen_bonus": -PUNISHMENTS['brand']['debuff']['regen_penalty']})
        await change_city_reputation(player_id, city,
            -PUNISHMENTS['brand']['debuff']['reputation_penalty'])
        new_count = brands_in_city + 1
        warning = ""
        if new_count >= 2:
            warning = "\n⚠️ **⚠️ У тебя 2 клейма в этом городе. Следующее тяжкое — КАЗНЬ.**"
        expires_dt = datetime.utcnow() + timedelta(hours=duration_hours)
        embed = discord.Embed(
            title="🔥 КЛЕЙМО ПРЕСТУПНИКА",
            description=(f"**{decision.get('text', 'Клеймо преступника')}**\n\n"
                         f"Раскалённое железо прижимают к плечу.\n"
                         f"Запах горелой плоти, крик на всю площадь.\n\n"
                         f"⚡ **−{PUNISHMENTS['brand']['debuff']['regen_penalty']} реген**\n"
                         f"💸 Торговцы в **{city}** берут на **+15%** больше\n"
                         f"💬 **−{PUNISHMENTS['brand']['debuff']['reputation_penalty']} реп**\n\n"
                         f"🔥 Клейм: **{new_count}/2** в {city}\n"
                         f"⏱️ Пройдёт через: **{duration_days} дн.**\n"
                         f"-# *{reason}*"
                         f"{warning}\n\n"
                         f"_В других городах о твоём клейме **никто не знает**._"),
            color=EMBED_COLORS["defeat"])
        embed.set_footer(text=f"Срок: {expires_dt.strftime('%d.%m.%Y %H:%M')} UTC")
        await channel.send(embed=embed)
        await db_log_event(f"🔥 **{p['name']}** клеймён в {city} на {duration_days} дн.")
        return


async def execute_for_brands(player_id, city, channel):
    p = await db_get_player(player_id)
    if not p: return
    await send_death_dm(player_id,
        cause=f"⚖️ Казнён в **{city}** — 2 клейма + новое тяжкое преступление")
    await db_save_player({**p,
        "is_alive": 0, "lives": 0, "hp": 0,
        "death_time": datetime.utcnow().isoformat(),
        "death_cause": f"Казнён в {city}"})
    await db_add_corpse(player_id, p['name'], p['race'], p['level'],
                        datetime.utcnow().isoformat())
    try:
        for g in bot.guilds:
            m = g.get_member(player_id)
            if m:
                await remove_race_role_and_nick(g, m, p['race'])
                try: await cleanup_player_death(g, player_id)
                except: pass
    except: pass
    await db_log_event(f"⚰️ **{p['name']}** казнён в {city} за 3-е тяжкое (2 клейма).")
    embed = discord.Embed(
        title=f"⚰️ КАЗНЬ — {p['name']}",
        description=(f"*Толпа расступилась. Палач поднял топор.*\n\n"
                     f"**{p['name']}** ({p['race']}, ур.{p['level']}) имел "
                     f"**2 активных клейма** в **{city}** и снова совершил тяжкое преступление.\n\n"
                     f"По законам города — окончательный приговор.\n\n"
                     f"🕯 Его имя будут шептать в тавернах как предостережение."),
        color=EMBED_COLORS["defeat"])
    await channel.send(embed=embed)


