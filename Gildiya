def monster_tier_reward(mtype):
    m = MONSTER_TYPES.get(mtype, MONSTER_TYPES["Гоблин"])
    tier_power = m["hp"] + m["atk"] * 3 + m["def"] * 2 + m["mdef"] * 2
    if m.get("is_boss"): return int(tier_power * 3)
    return max(10, int(tier_power * 0.8))

def calc_quest_reward(mtype, mcount, level, biome_bonus=1.0):
    base = monster_tier_reward(mtype)
    lvl_scale = 1.0 + max(0, level - 1) * 0.15
    count_scale = 1 + (mcount - 1) * 0.7
    reward = base * lvl_scale * count_scale * biome_bonus
    reward *= random.uniform(0.85, 1.15)
    return max(10, int(reward))

async def can_create_quest(kind):
    async with aiosqlite.connect(DB_PATH) as db:
        async with db.execute("SELECT COUNT(*) FROM quest_board WHERE status='open'") as cur:
            total = (await cur.fetchone())[0]
        if total >= MAX_QUEST_BOARD: return False
        async with db.execute("SELECT COUNT(*) FROM quest_board WHERE status='open' AND quest_kind=?", (kind,)) as cur:
            kind_cnt = (await cur.fetchone())[0]
    return kind_cnt < QUEST_LIMITS.get(kind, 10)


