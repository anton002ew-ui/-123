def get_item_weight(iid):
    it = ITEMS.get(iid, {})
    cat = it.get('cat', 'misc'); req = it.get('req', 1)
    if cat == "weapon":  return 2 + req
    if cat == "shield":  return 3 + req
    if cat == "armor":
        slot = it.get('slot', 'body')
        return {"body": 4 + req, "head": 1 + req//2,
                "hands": 1 + req//2, "feet": 1 + req//2}.get(slot, 2)
    if cat in ("amulet", "ring"): return 0
    if cat in ("potion", "scroll", "herb"): return 1
    if cat == "food":      return 2
    if cat == "material":  return 1
    if cat == "tool":      return 3
    return 1


