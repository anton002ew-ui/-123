@tasks.loop(minutes=60)
async def survival_tick():
    await bot.wait_until_ready()
    if not await db_is_bot_running(): return
    await db_cleanup_corpses()
    await mark_idle_players_afk()
    players = await db_get_all_alive_players()
    for p in players:
        if p.get('is_afk') == 1: continue
        if p.get('is_sleeping') == 1: continue
        if p.get('is_abandoned_spirit') == 1: continue
        if p.get('in_jail') == 1:
            # в тюрьме — голод/жажда замедлены, сон не восстанавливается
            race = p['race']; stats = get_race_stats(race)
            hunger = max(0, p['hunger'] - (p['max_hunger'] / (stats["hunger"] * 2)))
            thirst = max(0, p['thirst'] - (p['max_thirst'] / (stats["thirst"] * 2)))
            await db_save_player({**p, "hunger": hunger, "thirst": thirst})
            continue

        removed = await cleanup_expired_effects(p)
        if removed: p = await db_get_player(p['discord_id'])
        race = p['race']; stats = get_race_stats(race)
        in_city = p.get('in_city', 1); near = p.get('near_temple', 0)
        loc = p.get('location') or ""
        in_holy = (in_city == 1 and loc not in DARK_CITIES) or (near == 1)
        night = is_night()
        tm = TEMPLE_MODIFIERS.get(race) if in_holy else None
        ce = get_city_effect(race, p.get('element'), loc, in_city, near)
        hph = ce.get("hp_per_hour", 0); rd = ce.get("regen", 0)
        ab_p = ABILITY_EFFECTS.get(race, {})
        pr = 1 if ab_p.get('key') == "out_of_battle_regen" else 0

        if race == "Нежить":
            hp = p['hp']
            if night and not in_holy: hp = min(p['max_hp'], hp + 1)
            if hp < p['max_hp'] * 0.3 and loc not in DARK_CITIES: hp -= 1
            if in_holy and tm and tm.get('hp_inside'): hp += tm['hp_inside']
            hp += hph + pr
            if hp <= 0:
                nl = max(0, get_lives(p) - 1); dt = datetime.utcnow().isoformat()
                await db_save_player({**p, "hp": 0, "is_alive": 0, "lives": nl,
                                      "death_time": dt})
                await db_add_corpse(p['discord_id'], p['name'], race, p['level'], dt)
                continue
            await db_save_player({**p, "hp": hp}); continue

        if race == "Элементали": continue

        if p['in_spirit_form'] == 1:
            body_hp = p.get('body_hp') or 0
            if body_hp <= 0 or p.get('body_dead') == 1:
                bdt = p.get('body_death_time')
                if bdt:
                    try:
                        delta_h = (datetime.utcnow() - datetime.fromisoformat(bdt)).total_seconds() / 3600
                        if delta_h >= 24:
                            await db_save_player({**p,
                                "hp": 0, "is_alive": 0, "lives": 0,
                                "in_spirit_form": 0,
                                "death_time": datetime.utcnow().isoformat()})
                            await db_add_corpse(p['discord_id'], p['name'],
                                                p['race'], p['level'],
                                                datetime.utcnow().isoformat())
                            try:
                                for g in bot.guilds:
                                    m = g.get_member(p['discord_id'])
                                    if m: await remove_race_role_and_nick(g, m, "Фантазмы")
                            except: pass
                            await db_log_event(f"💀 Дух **{p['name']}** рассеялся.")
                    except: pass
            continue

        hunger = max(0, p['hunger'] - (p['max_hunger'] / stats["hunger"]))
        thirst = max(0, p['thirst'] - (p['max_thirst'] / stats["thirst"]))
        sleep = max(0, p['sleep'] - (p['max_sleep'] / 48))
        hp = p['hp']
        if hunger > p['max_hunger'] * 0.5 and thirst > p['max_thirst'] * 0.5 \
                and sleep > p['max_sleep'] * 0.5:
            regen = stats["regen"] + rd
            if night and not in_holy: regen += 0.5
            if in_holy and tm and tm.get('regen_bonus'): regen += tm['regen_bonus']
            regen += pr
            hp = min(hp + max(0, regen), p['max_hp'])
        if hunger == 0 or thirst == 0 or sleep == 0: hp -= 1
        if in_holy and tm and tm.get('hp_inside'): hp += tm['hp_inside']
        if hph: hp += hph

        if hp <= 0:
            if race == "Фантазмы":
                if p.get('possessed_corpse_id'):
                    async with aiosqlite.connect(DB_PATH) as db:
                        await db.execute("DELETE FROM possessable_corpses WHERE id=?",
                                         (p['possessed_corpse_id'],))
                        await db.commit()
                await db_save_player({**p,
                    "hp": 0, "is_alive": 1, "lives": 1,
                    "in_spirit_form": 1, "body_hp": 0, "body_max_hp": 0, "body_dead": 1,
                    "possessed_corpse_id": None, "possessed_since": None,
                    "is_abandoned_spirit": 1,
                    "abandoned_since": datetime.utcnow().isoformat()})
                await db_log_event(f"🌫️ Фантазм **{p['name']}** снова брошенный дух.")
                continue
            cause = "умер от голода"
            if thirst == 0: cause = "погиб от жажды"
            elif sleep == 0: cause = "умер от истощения"
            await send_death_dm(p['discord_id'], cause=cause)
            nl = max(0, get_lives(p) - 1); dt = datetime.utcnow().isoformat()
            if p.get('possessed_corpse_id'):
                async with aiosqlite.connect(DB_PATH) as db:
                    await db.execute("DELETE FROM possessable_corpses WHERE id=?",
                                     (p['possessed_corpse_id'],))
                    await db.commit()
            await db_save_player({**p, "hp": 0, "is_alive": 0, "lives": nl,
                                  "death_time": dt,
                                  "possessed_corpse_id": None, "possessed_since": None,
                                  "is_abandoned_spirit": 0, "in_spirit_form": 0})
            await db_add_corpse(p['discord_id'], p['name'], race, p['level'], dt)
            continue
        await db_save_player({**p, "hp": hp, "hunger": hunger,
                              "thirst": thirst, "sleep": sleep})


