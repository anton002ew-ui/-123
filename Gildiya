                        embed_title=f"🎁 Добыча — {t['enemy_name']}")

            # ПОДЗЕМЕЛЬЕ
            if sess:
                cr = sess['room']
                async with aiosqlite.connect(DB_PATH) as db:
                    db.row_factory = aiosqlite.Row
                    async with db.execute("SELECT * FROM dungeons WHERE id=?", (sess['dungeon_id'],)) as cur:
