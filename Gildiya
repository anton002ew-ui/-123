    # АТАКА МОБА
    if t and t['is_battle'] and not success:
        ab_bonus = get_ability_bonus(p)
        if ab_bonus.get('dodge', 0) > 0:
            eff = parse_active_effects(p)
            for k in list(eff.keys()):
                if eff[k]['data'].get('dodge'):
                    del eff[k]
                    await db_save_player({**dict(p), "active_effects": json.dumps(eff)})
                    await interaction.channel.send(f"🕊 **{p['name']}** уклонился!")
                    return

        is_magic_enemy = enemy_stats_dict.get("is_magic") or is_magic_monster(t['enemy_name'])
        if is_magic_enemy:
