class EquipmentSlotView(ui.View):
    def __init__(self, pid, slot):
        super().__init__(timeout=300); self.pid = pid; self.slot = slot
    async def refresh(self):
        p = await db_get_player(self.pid)
        equipped = await get_equipped_items(self.pid)
        cur = equipped.get(self.slot)
        embed = discord.Embed(title=f"🎽 {SLOT_NAMES.get(self.slot, self.slot)}", color=0x3182ce)
        if cur:
            rolled = json.loads(cur.get('rolled_stats') or '{}')
            lines = describe_rolled_stats(rolled, cur.get('rolled_dmg', 0))
            rarity = cur.get('rarity', 0)
            embed.add_field(name=f"Надето — {RARITY_NAMES.get(rarity, '⚪')}",
                value=f"**{cur['item_id']}** (⭐×{cur['quality']})\n" + "\n".join(lines),
                inline=False)
        else:
            embed.add_field(name="Надето", value="_пусто_", inline=False)
        self.clear_items()
        inv = await get_player_inventory(self.pid)
        candidates = []
        for i in inv:
            it = ITEMS.get(i['item_id'], {})
            it_slot = it.get('equip_slot')
            if not it_slot: continue
            if it_slot == self.slot or \
               (it_slot == "hands" and self.slot in ("hands_left","hands_right")) or \
               (it_slot == "feet" and self.slot in ("feet_left","feet_right")):
                if i.get('equipped_slot') != self.slot: candidates.append(i)
        if candidates:
            opts = []
            for i in candidates[:25]:
                it = ITEMS.get(i['item_id'], {})
                req = it.get('req', 1)
                label = f"{i['item_id']} (ур.{req}+)"
                if p and p['level'] < req: label = "🔒 " + label
                opts.append(discord.SelectOption(label=label[:80], value=str(i['id'])))
            sel = ui.Select(placeholder="Что надеть...", options=opts, row=0)
            sel.callback = self._on_equip; self.add_item(sel)
        if cur:
            b = ui.Button(label="🗑 Снять", style=discord.ButtonStyle.danger, row=1)
            b.callback = self._on_unequip; self.add_item(b)
        b2 = ui.Button(label="← Назад", style=discord.ButtonStyle.secondary, row=1)
        b2.callback = self._on_back; self.add_item(b2)
        return embed
    async def _on_equip(self, interaction):
        inv_id = int(interaction.data['values'][0])
        ok, msg = await equip_item(self.pid, inv_id, self.slot)
        if not ok:
            await interaction.response.send_message(f"❌ {msg}", ephemeral=True); return
        embed = await self.refresh()
        await interaction.response.edit_message(embed=embed, view=self)
    async def _on_unequip(self, interaction):
        await unequip_slot(self.pid, self.slot)
        embed = await self.refresh()
        await interaction.response.edit_message(embed=embed, view=self)
    async def _on_back(self, interaction):
        embed = await build_equipment_overview(self.pid)
        await interaction.response.edit_message(embed=embed, view=EquipmentView(self.pid))


class UseSelectView(ui.View):
    def __init__(self, opts, pid):
        super().__init__(timeout=120); self.pid = pid
        sel = ui.Select(placeholder="🧪 Использовать...", options=opts)
        sel.callback = self._on_use; self.add_item(sel)
    async def _on_use(self, interaction):
        inv_id = int(interaction.data['values'][0])
        p = await db_get_player(self.pid)
        blocked, msg = await is_blocked_action(p, "использовать предметы")
        if blocked:
            await interaction.response.send_message(msg, ephemeral=True); return
        async with aiosqlite.connect(DB_PATH) as db:
            db.row_factory = aiosqlite.Row
            async with db.execute("SELECT * FROM inventory WHERE id=?", (inv_id,)) as cur:
                inv = await cur.fetchone()
        if not inv: return
        inv = dict(inv); iid = inv['item_id']
        it = ITEMS.get(iid, {}); msg = "✅ Использовано."
        if it.get('cat') == "potion":
            eff = it.get('effect')
            if eff == "heal":
                new_hp = min(p['max_hp'], p['hp'] + it['value'])
                await db_save_player({**p, "hp": new_hp})
                msg = f"❤️ +{it['value']} HP → {new_hp}/{p['max_hp']}"
            elif eff.startswith("buff_"):
                key = eff.replace("buff_", "")
                await add_active_effect(p, f"potion_{key}", it.get('dur', 600),
                                        {f"{key}_flat": it['value']})
                msg = f"⚡ +{it['value']} {key.upper()}"
        elif it.get('cat') == "food":
            rolled = json.loads(inv.get('rolled_stats') or '{}')
            bonus_hp = rolled.get('food_hp', it.get('heal_hp', 0))
            bonus_mag = rolled.get('food_mag', it.get('heal_mag', 0))
            nh = min(p['max_hunger'], p['hunger'] + it.get('hunger', 0))
            nt = min(p['max_thirst'], p['thirst'] + it.get('thirst', 0))
            new_hp = min(p['max_hp'], p['hp'] + bonus_hp)
            if bonus_mag > 0:
                await add_active_effect(p, f"food_mag_{iid}", 1800,
                                        {"mag": bonus_mag, "atk_flat": bonus_mag // 2})
            await db_save_player({**p, "hunger": nh, "thirst": nt, "hp": new_hp})
            msg = f"🍖 Голод: {nh:.0f}"
            if bonus_hp: msg += f"\n❤️ +{bonus_hp} HP"
            if bonus_mag: msg += f"\n✨ +{bonus_mag} MAG (30 мин)"
        elif it.get('cat') == "scroll":
            eff = it.get('effect')
            if eff == "heal_pct":
                heal = int(p['max_hp'] * it['value'] / 100)
                new_hp = min(p['max_hp'], p['hp'] + heal)
                await db_save_player({**p, "hp": new_hp})
                msg = f"✨ +{heal} HP ({it['value']}%) → {new_hp}/{p['max_hp']}"
            elif eff == "heal":
                new_hp = min(p['max_hp'], p['hp'] + it['value'])
                await db_save_player({**p, "hp": new_hp})
                msg = f"✨ +{it['value']} HP → {new_hp}/{p['max_hp']}"
            elif eff == "damage":
                t = await db_get_gameplay_thread(interaction.channel.id)
                if not t or not t['is_battle']:
                    await interaction.response.send_message(
                        "📜 Свиток урона нужен в бою.", ephemeral=True); return
                dmg = int(it['value'] + p['mag'] / 2)
                element = it.get('element', '')
                hp_left = max(0, t['enemy_hp'] - dmg)
                await db_add_contribution(interaction.channel.id, interaction.user.id, damage=dmg)
                await interaction.response.send_message(
                    f"📜 **{iid}** — {dmg} урона ({element})")
                es = json.loads(t['enemy_stats'] or '{}')
                await db_save_gameplay_thread(t['thread_id'], t['owner_id'],
                    json.loads(t['participants'] or '[]'), is_battle=1,
                    enemy_name=t['enemy_name'], enemy_stats=es,
                    enemy_hp=hp_left, enemy_max_hp=t['enemy_max_hp'],
                    enemy_level=t['enemy_level'], location=t['location'],
                    in_city=t['in_city'], story_summary=t['story_summary'] or "")
                await interaction.channel.send(
                    f"❤️ **{t['enemy_name']}**: HP {hp_left}/{t['enemy_max_hp']}")
                await remove_inventory_item(self.pid, iid, 1, inv['quality'])
                return
        await remove_inventory_item(self.pid, iid, 1, inv['quality'])
        await interaction.response.send_message(msg, ephemeral=True)

