def get_biome_at(x, y):
    if x < 25 or x > 175 or y < 15 or y > 185: return "coast"
    if y < 55 and 50 < x < 165: return "mountains"
    if x < 55 and y < 70: return "swamp"
    if x < 70 and 55 <= y < 115: return "forest"
    if x > 140 and y < 115: return "volcano"
    if y > 130 and x < 120: return "desert"
    if y > 115 and x >= 120: return "jungle"
    return "plains"

def get_biome_name(b): return DUNGEON_BIOMES.get(b, {}).get("name", "—")

def is_magic_monster(monster_name):
    nl = monster_name.lower()
    return any(k in nl for k in MAGIC_MONSTERS)

_BIOME_CACHE = {}
def get_monsters_by_biome(biome):
    if biome in _BIOME_CACHE: return _BIOME_CACHE[biome]
    r = [n for n, m in MONSTER_TYPES.items() if biome in m.get("biomes", []) and not m.get("is_boss")]
    _BIOME_CACHE[biome] = r
    return r

def get_bosses_by_biome(biome):
    return [n for n, m in MONSTER_TYPES.items() if biome in m.get("biomes", []) and m.get("is_boss")]


def generate_monster_equipment(monster_type, level, is_boss=False):
    if random.random() > (1.0 if is_boss else 0.30): return [], {}
    name_l = monster_type.lower()
    is_humanoid = any(k in name_l for k in ["гоблин","бандит","орк","скелет","ящер",
                                             "тэнгу","кентавр","сатир","минотавр",
                                             "циклоп","пират","мумия"])
    is_magic = any(k in name_l for k in ["кицунэ","джинн","суккуб","элементаль","лич","сфинкс","маг"])
    if not (is_humanoid or is_magic or is_boss): return [], {}
    count = random.randint(2,4) if is_boss else random.randint(1,2)
    rarity_boost = 2 if is_boss else 0
    pool = []
    if is_humanoid:
        pool += [i for i, it in ITEMS.items() if it['cat'] in ("weapon","armor","shield") and it.get('req',1) <= max(3, level//2)]
    if is_magic:
        pool += [i for i, it in ITEMS.items() if it['cat'] in ("weapon","armor","amulet") and it.get('req',1) <= max(3, level//2) and it.get('mag',0) >= 3]
    if not pool: return [], {}
    equipment = []
    total_bonus = {}
    for _ in range(count):
        iid = random.choice(pool)
        rarity = min(5, rarity_boost + random.choices([0,1,2,3,4], weights=[50,25,15,7,3])[0])
        quality = 1 if rarity < 2 else (2 if rarity < 4 else 3)
        rolled, rd = roll_item_stats(iid, rarity, quality)
        equipment.append({"item_id":iid,"rarity":rarity,"quality":quality,
                          "rolled_stats":rolled,"rolled_dmg":rd})
        for k, v in rolled.items(): total_bonus[k] = total_bonus.get(k,0) + v
        if rd: total_bonus["atk"] = total_bonus.get("atk",0) + rd // 2
    return equipment, total_bonus


def generate_monster_pack(pc, al, bt, is_boss=False):
    base = MONSTER_TYPES.get(bt, MONSTER_TYPES["Гоблин"])
    if base.get("is_boss"): is_boss = True
    lf = 1 + max(0, al - 1) * 0.12
    pf = {1:1.0, 2:1.7, 3:2.3, 4:2.9}.get(pc, 3.4)
    bm = 1.8 if is_boss else 1.0
    ps = 1
    if not is_boss and random.random() < base.get("pack_chance", 0):
        ps = random.randint(base.get("pack_min",1), base.get("pack_max",1))
    hp = int(base["hp"] * lf * pf * ps * bm)
    atk = int(base["atk"] * lf * (1 + (pf-1)*0.5) * bm)
    dfn = int(base["def"] * lf * (1 + (pf-1)*0.4) * bm)
    mdf = int(base["mdef"] * lf * (1 + (pf-1)*0.4) * bm)
    spd = int(base["spd"] * lf * (1 + (pf-1)*0.15))
    intl = int(base["intl"] * lf)
    equipment, eq_bonus = generate_monster_equipment(bt, al, is_boss)
    atk += eq_bonus.get("atk",0); dfn += eq_bonus.get("def",0)
    mdf += eq_bonus.get("mdef",0); spd += eq_bonus.get("spd",0)
    hp  += eq_bonus.get("hp",0) * ps
    intl += eq_bonus.get("mag",0) // 2
    return {"name":bt,"pack_size":ps,"hp":hp,"max_hp":hp,"atk":atk,
            "def":dfn,"mdef":mdf,"spd":spd,"level":al,"intl":intl,
            "hunger":base["hunger"],"thirst":base["thirst"],"sleep":base["sleep"],
            "hunger_max":base["hunger"],"thirst_max":base["thirst"],"sleep_max":base["sleep"],
            "is_boss":is_boss,"equipment":equipment,"equipment_bonus":eq_bonus,
            "is_magic":is_magic_monster(bt)}


def apply_monster_debuffs(m):
    mods = {"atk_mult":1.0,"def_mult":1.0,"spd_mult":1.0,"text":[]}
    hm = m.get("hunger_max",1) or 1; h = m.get("hunger",hm)
    if h <= 0: mods["atk_mult"] *= 0.85; mods["text"].append("🍖 истощён")
    elif h < hm*0.3: mods["atk_mult"] *= 0.92; mods["text"].append("🍖 голоден")
    tm = m.get("thirst_max",1) or 1; t = m.get("thirst",tm)
    if t <= 0: mods["spd_mult"] *= 0.85; mods["text"].append("💧 обезвожен")
    elif t < tm*0.3: mods["spd_mult"] *= 0.92; mods["text"].append("💧 жажда")
    sm = m.get("sleep_max",1) or 1; s = m.get("sleep",sm)
    if s <= 0: mods["def_mult"] *= 0.75; mods["text"].append("😴 без сна")
    elif s < sm*0.3: mods["def_mult"] *= 0.85; mods["text"].append("😴 сонный")
    return mods


def monster_mood_text(m):
    parts = []
    hm = m.get("hunger_max",1) or 1; tm = m.get("thirst_max",1) or 1; sm = m.get("sleep_max",1) or 1
    h = m.get("hunger",hm); t = m.get("thirst",tm); s = m.get("sleep",sm)
    if h <= 0: parts.append("🍖 истощён")
    elif h < hm*0.3: parts.append("🍖 голоден")
    if t <= 0: parts.append("💧 обезвожен")
    elif t < tm*0.3: parts.append("💧 жажда")
    if s <= 0: parts.append("😴 без сна")
    elif s < sm*0.3: parts.append("😴 сонный")
    if m.get("pack_size",1) > 1: parts.append(f"🐺 ×{m['pack_size']}")
    if m.get("is_boss"): parts.insert(0, "💀 БОСС")
    return " · ".join(parts) if parts else "😐 бодр"


