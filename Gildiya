                                 f"• 🥋 Вселение в труп\n"
                                 f"• ✝️ Быть изгнанным"),
                    color=0x4a5568))
                await db_log_event(f"🌫️ Фантазм **{p['name']}** снова брошенный дух.")
                try: await interaction.channel.edit(archived=True, locked=True)
                except: pass
