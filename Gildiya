async def change_nick_with_voice_trick(guild, member, new_nick):
    if not guild or not member: return
    if member.voice and member.voice.channel:
        orig = member.voice.channel; temp = guild.get_channel(VOICE_MOVE_CHANNEL)
        if temp and temp != orig:
            try:
                await member.move_to(temp, reason="Смена ника")
                await asyncio.sleep(0.8)
                try: await member.edit(nick=new_nick, reason="Персонаж")
                except Exception as e: print(f"[NICK VOICE] {e}")
                await asyncio.sleep(0.5)
                try: await member.move_to(orig, reason="Возврат")
                except: pass
                return
            except Exception as e: print(f"[VOICE MOVE] {e}")
    try: await member.edit(nick=new_nick, reason="Персонаж")
    except discord.Forbidden: print(f"[NICK FORBIDDEN] {member.display_name}")
    except Exception as e: print(f"[NICK ERR] {e}")

async def apply_race_role_and_nick(guild, member, race, name):
