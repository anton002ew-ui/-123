async def is_settlement_blocked(name):
    s = await get_settlement(name)
    if not s or not s.get('blocked_until'): return False, None
    try:
        until = datetime.fromisoformat(s['blocked_until'])
        if until > datetime.utcnow(): return True, until
    except: pass
    return False, None

async def register_settlement_raid(name, success):
    s = await get_settlement(name)
    if not s: return
    cnt = (s['raids_count'] or 0)
    if success: cnt += 1
    else: cnt = max(0, cnt - 1)
    blocked = s['blocked_until']
    if cnt >= 3:
        blocked = (datetime.utcnow() + timedelta(days=2)).isoformat()
        await db_log_event(f"🚫 **{name}** разорён трижды — недоступен 2 дня!")
        cnt = 0
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("UPDATE settlements SET raids_count=?, blocked_until=? WHERE name=?",
                         (cnt, blocked, name)); await db.commit()

