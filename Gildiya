async def ai_choose_punishment(player_name, severity, caught_in_act, witness_name, brands_in_city):
    if brands_in_city >= 2 and severity >= 3:
        return {"type": "execution", "text": "Ты уже дважды клеймён. Третье тяжкое — казнь."}
    prompt = (
        f"Ты — судья в фэнтези-RPG.\n"
