async def dispatch_panel_action(interaction, key, thread_id):
    if key != "afk_exit":
        await touch_player_action(interaction.user.id)
    p = await db_get_player(interaction.user.id)
    if not p:
        try: await interaction.response.send_message("❌", ephemeral=True)
        except: pass
        return

    # Брошенный дух
    if p.get('is_abandoned_spirit') == 1 and key not in ("possess", "map", "profile", "help_spirit"):
        try:
            await interaction.response.send_message(
                "🌫️ Брошенный дух может только **вселяться**.", ephemeral=True)
        except: pass
        return

    try:
        if key == "attack":
            t = await db_get_gameplay_thread(thread_id)
            if not t or not t['is_battle']:
                await interaction.response.send_message("⚔️ Не бой.", ephemeral=True); return
            spec = DIFFICULTY_TABLE.get(4, DIFFICULTY_TABLE[3])
            await interaction.response.send_message("⚔️ Атака",
                view=DiceView(thread_id, spec, "атака", interaction.user.id), ephemeral=True)
        elif key == "defend":
            eff = parse_active_effects(p)
            eff["_defend"] = {"until":(datetime.utcnow()+timedelta(seconds=60)).isoformat(),
                              "data":{"def_mult":1.3}}
            await db_save_player({**dict(p), "active_effects":json.dumps(eff)})
            await interaction.response.send_message("🛡 Защита на минуту.", ephemeral=True)
        elif key == "use_item": await panel_use_item(interaction, thread_id)
        elif key == "flee": await panel_flee(interaction, thread_id)
        elif key == "attack_fantasm":
            px = p.get('player_x', 100) or 100; py = p.get('player_y', 100) or 100
            async with aiosqlite.connect(DB_PATH) as db:
                db.row_factory = aiosqlite.Row
                async with db.execute("""SELECT * FROM players
                    WHERE race='Фантазмы' AND is_alive=1
                      AND (is_abandoned_spirit=1 OR in_spirit_form=1)""") as cur:
