async def generate_image(prompt):
    headers = {"Authorization": f"Bearer {API_KEY}", "Content-Type": "application/json"}
    payload = {"model": IMAGE_MODEL, "prompt": prompt, "n": 1, "size": "1024x1024"}
    try:
        async with aiohttp.ClientSession() as s:
            async with s.post(IMAGE_API_URL, json=payload, headers=headers, timeout=180) as r:
                if r.status != 200: return None
                data = await r.json()
                item = None
                if isinstance(data.get('data'), list) and data['data']: item = data['data'][0]
                elif isinstance(data.get('data'), dict): item = data['data']
                elif isinstance(data.get('output'), list) and data['output']: item = data['output'][0]
                else: item = data if isinstance(data, dict) else None
                if not isinstance(item, dict): return None
                url = item.get('url') or item.get('image_url') or item.get('image') or item.get('imageUrl')
                if url and isinstance(url, str) and url.startswith("http"): return url
                b64 = item.get('b64_json') or item.get('b64') or item.get('image_base64') or item.get('base64')
                if b64 and isinstance(b64, str):
                    if b64.startswith("data:") and "," in b64: b64 = b64.split(",",1)[1]
                    ensure_photo_dir()
                    fp = os.path.join(PHOTO_DIR, f"img_{datetime.now().strftime('%Y%m%d_%H%M%S_%f')}.png")
                    with open(fp,'wb') as f: f.write(base64.b64decode(b64))
                    return fp
                return None
    except Exception as e:
        print(f"[IMG ERR] {e}"); return None


async def send_photo_message(channel, embed, src, view=None, content=""):
    if not src:
        await channel.send(content=content, embed=embed, view=view); return
    if src.startswith("http"):
        embed.set_image(url=src); await channel.send(content=content, embed=embed, view=view); return
    ap = os.path.abspath(src)
    if not os.path.exists(ap):
        await channel.send(content=content + "\n⚠️ Файл не найден.", embed=embed, view=view); return
    fn = os.path.basename(ap); f = discord.File(ap, filename=fn)
    embed.set_image(url=f"attachment://{fn}")
    try: await channel.send(content=content, embed=embed, file=f, view=view)
    except Exception as e: await channel.send(content=content + f"\n⚠️ {e}", embed=embed, view=view)

async def send_image_message(channel, caption, src, color=0x2b6cb0, content="", view=None):
    embed = discord.Embed(title=caption, color=color)
    await send_photo_message(channel, embed, src, view=view, content=content)

def ensure_photo_dir():
    try: os.makedirs(PHOTO_DIR, exist_ok=True); return True
    except: return False


