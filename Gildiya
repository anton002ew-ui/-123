def prof_buff_level(level): return level // 5

def profession_bonus_at_level(prof, level):
    info = PROFESSION_BUFFS.get(prof, {})
    stars = prof_buff_level(level)
    b = {"craft_bonus": 0, "gold_bonus": 0, "atk_bonus": 0, "hp_bonus": 0,
         "heal_bonus": 0, "crit_bonus": 0, "rep_bonus": 0, "gather_bonus": 0}
    if "bonus_per_5" in info:  b["craft_bonus"] = info["bonus_per_5"] * stars
    if "gold_per_5" in info:   b["gold_bonus"]  = info["gold_per_5"] * stars
    if "atk_bonus" in info:    b["atk_bonus"]   = info["atk_bonus"] * stars
    if "hp_bonus" in info:     b["hp_bonus"]    = info["hp_bonus"] * stars
    if "heal_bonus" in info:   b["heal_bonus"]  = info["heal_bonus"] * stars
    if "crit_bonus" in info:   b["crit_bonus"]  = info["crit_bonus"] * stars
    if "reputation" in info:   b["rep_bonus"]   = info["reputation"] * stars
    for k in ["food_bonus", "hunt_bonus", "wood_bonus", "fuel_bonus"]:
        if k in info: b["gather_bonus"] += info[k] * stars
    return b

def prof_xp_for_next(level):
    if level >= MAX_PROFESSION_LEVEL: return None
    return 100 + level * 40


