                    mentionable=False, reason=f"Роль расы {race}")
            except Exception as e: print(f"[ROLE CREATE] {e}"); role = None
        if role:
            try: await member.add_roles(role, reason=f"Персонаж: {race}")
            except Exception as e: print(f"[ROLE ADD] {e}")
        await change_nick_with_voice_trick(guild, member, f"{race} - {name}")
        return role
    except Exception as e: print(f"[APPLY RACE ERR] {e}"); return None

