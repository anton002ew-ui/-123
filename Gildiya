async def wake_up_from_sleep(player_id):
    p = await db_get_player(player_id)
    if not p: return False, "❌ Нет персонажа"
    if p.get('is_sleeping') != 1:
        return False, "⚠️ Ты не спишь"
    hours = 0.0
    try:
        start = datetime.fromisoformat(p.get('sleep_started_at') or "")
        hours = min(SLEEP_MAX_HOURS, (datetime.utcnow() - start).total_seconds() / 3600)
    except: pass
    house = await get_player_house(player_id)
    tier = house['tier'] if house else 1
    hp_restored = int((SLEEP_HP_PER_HOUR_BASE + tier * 2) * hours)
    sleep_restored = int(SLEEP_SLEEP_RESTORE * hours)
    hunger_lost = int(SLEEP_HUNGER_PER_HOUR * hours)
    thirst_lost = int(SLEEP_HUNGER_PER_HOUR * 0.5 * hours)
    new_hp = min(p['max_hp'], p['hp'] + hp_restored)
    new_sleep = min(p['max_sleep'], (p.get('sleep') or 0) + sleep_restored)
    new_hunger = max(0, (p.get('hunger') or 0) - hunger_lost)
    new_thirst = max(0, (p.get('thirst') or 0) - thirst_lost)
    await db_save_player({**p,
        "is_sleeping": 0, "sleep_started_at": None,
        "is_afk": 0, "afk_since": None,
        "hp": new_hp, "sleep": new_sleep,
        "hunger": new_hunger, "thirst": new_thirst,
        "last_action_at": datetime.utcnow().isoformat()})
    embed = discord.Embed(
        title="☀️ Ты проснулся",
        description=(
            f"Провёл во сне: **{hours:.1f} ч**\n\n"
            f"❤️ **+{hp_restored}** HP → {new_hp}/{p['max_hp']}\n"
            f"😴 **+{sleep_restored}** сна → {new_sleep:.0f}\n"
            f"🍖 Голод: **−{hunger_lost}** → {new_hunger:.0f}\n"
            f"💧 Жажда: **−{thirst_lost}** → {new_thirst:.0f}"),
        color=EMBED_COLORS["success"])
    return True, embed


