async def build_equipment_overview(pid):
    p = await db_get_player(pid)
    equipped = await get_equipped_items(pid)
    bonuses = get_equipment_bonuses_from_items(equipped)
    embed = discord.Embed(title=f"🎽 Экипировка — {p['name']}",
        description="*Нажмите слот, чтобы надеть/снять.*", color=0x3182ce)
    for slot in EQUIP_SLOTS:
        cur = equipped.get(slot)
        if cur:
            rolled = json.loads(cur.get('rolled_stats') or '{}')
            bstr = []
            if cur.get('rolled_dmg'): bstr.append(f"+{cur['rolled_dmg']}dmg")
            for k, v in rolled.items(): bstr.append(f"+{v}{k[0].upper()}")
            q = f" ⭐×{cur['quality']}" if cur['quality'] > 1 else ""
            r = cur.get('rarity', 0)
            rt = f" {RARITY_NAMES[r].split()[0]}" if r > 0 else ""
            val = f"**{cur['item_id']}**{rt}{q} · {' '.join(bstr)}"
        else:
            val = "_пусто_"
        embed.add_field(name=SLOT_NAMES[slot], value=val, inline=False)
    tot = []
    for k, lbl in [("hp","❤️ HP"),("atk","⚔️ ATK"),("def","🛡 DEF"),("mdef","🔮 MDEF"),
                   ("mag","✨ MAG"),("spd","💨 SPD"),("intl","🧠 INTL"),("luck","🍀 Удача")]:
        v = bonuses.get(k, 0)
        if v: tot.append(f"{lbl}: **+{v}**")
    embed.add_field(name="📊 Суммарно", value="\n".join(tot) or "—", inline=False)
    return embed


