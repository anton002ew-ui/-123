def get_herbs_for_biome(biome):
    """Возвращает список (имя, редкость) трав для биома."""
    return [(n, d["rarity"]) for n, d in HERBS.items() if biome in d["biomes"]]


def roll_herb_gather(biome, luck_bonus=0.0):
    """Пробует собрать траву в биоме."""
    pool = get_herbs_for_biome(biome)
    if not pool: return None
    for name, rarity in pool:
        if random.random() < rarity + luck_bonus:
            return name
    return None


