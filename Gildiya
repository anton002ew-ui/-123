async def craft_item(player_id, item_id):
    p = await db_get_player(player_id)
    if not p: return False, "Нет персонажа"
    if p['is_alive'] == 0: return False, "Вы мертвы"
    if p.get('in_city') != 1: return False, "Крафтить можно только в городе"

    recipe = CRAFT_RECIPES.get(item_id)
    if not recipe: return False, "Рецепт не найден"

    prof = recipe['prof']
    prof_levels = json.loads(p.get('profession_level') or '{}')
    player_lvl = prof_levels.get(prof, 0)

    is_food = recipe.get('is_food', False)
    if not is_food and player_lvl < recipe.get('prof_level', 0):
        return False, f"Нужен **{prof}** уровня {recipe['prof_level']}+ (у вас {player_lvl})"

    inv = await get_player_inventory(player_id)
    inv_map = {}
    for i in inv:
        inv_map[i['item_id']] = inv_map.get(i['item_id'], 0) + i['count']

    missing = []
    for mat, need in recipe['mat'].items():
        if need <= 0: continue
        have = inv_map.get(mat, 0)
        if have < need:
            missing.append(f"{mat} ×{need - have}")
    if missing:
        return False, "Не хватает: " + ", ".join(missing)

    for mat, need in recipe['mat'].items():
        if need <= 0: continue
        await remove_inventory_item(player_id, mat, need)

    if is_food:
        food_item = ITEMS.get(item_id, {})
        base_hp = food_item.get('heal_hp', 0)
        base_mag = food_item.get('heal_mag', 0)
        prof_bonus = 1.0 + player_lvl * 0.04
        boosted_hp = int(base_hp * prof_bonus)
        boosted_mag = int(base_mag * prof_bonus)

        async with aiosqlite.connect(DB_PATH) as db:
            await db.execute("""INSERT INTO inventory
                (player_id, item_id, count, quality, rarity, rolled_stats, rolled_dmg)
                VALUES (?, ?, ?, ?, ?, ?, ?)""",
                (player_id, item_id, recipe.get('result_count', 1), 1, 0,
                 json.dumps({"food_hp": boosted_hp, "food_mag": boosted_mag}), 0))
            await db.commit()

        await add_profession_xp(player_id, prof, recipe['xp'])
        return True, (f"✅ Создано: **{item_id}** ×{recipe.get('result_count',1)}\n"
                      f"❤️ HP: +{boosted_hp} · ✨ MAG: +{boosted_mag}\n"
                      f"_(бонус +{int((prof_bonus-1)*100)}% от {prof} ур.{player_lvl})_")

    prof_bonus = profession_bonus_at_level(prof, player_lvl)
    craft_bonus = prof_bonus.get('craft_bonus', 0)

    rarity = 0
    roll = random.random()
    if roll < 0.05 + craft_bonus * 0.02: rarity = 2
    elif roll < 0.20 + craft_bonus * 0.03: rarity = 1
    if player_lvl >= 25 and random.random() < 0.05: rarity = max(rarity, 2)

    quality = 1
    if rarity >= 2 and random.random() < 0.3: quality = 2

    await add_inventory_item(player_id, item_id, count=recipe.get('result_count', 1),
                             quality=quality, rarity=rarity)
    await add_profession_xp(player_id, prof, recipe['xp'])

    rar_txt = RARITY_NAMES.get(rarity, "")
    return True, (f"✅ Создано: **{item_id}** ×{recipe.get('result_count',1)} "
                  f"({rar_txt} ⭐×{quality}) [+{recipe['xp']} XP {prof}]")


