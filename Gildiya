def get_city_effect(race, element, location, in_city, near_temple=0):
    is_holy = (in_city == 1 and location not in DARK_CITIES) or near_temple == 1
    is_dark = (in_city == 1 and location in DARK_CITIES)
    if not is_holy and not is_dark: return {}
    if race == "Ангелы" and is_dark:
        return {"regen": -2, "text": "⛔ Ангел среди тёмных"}
    if race == "Демоны" and is_holy and location == ANGEL_CITY:
        return {"regen": -2, "text": "⛔ Демон в Чертоге"}
    if race in ("Нежить", "Вампиры", "Они", "Фантазмы") and is_holy and location == ANGEL_CITY:
        return {"hp_per_hour": -1, "text": "☠️ Тьма в Чертоге"}
    if race == "Элементали" and element:
        if location == ELEMENT_CITIES.get(OPPOSITE_ELEMENTS.get(element)):
            return {"mag": -2, "text": f"💥 Стихия у {OPPOSITE_ELEMENTS[element]}"}
        if location == ELEMENT_CITIES.get(element):
            return {"mag": 2, "regen": 1, "text": f"✨ Родная {element}"}
    if race in NEUTRAL_RACES and is_holy and location == ANGEL_CITY:
        return {"regen": 1, "text": "✨ Нейтрал"}
    if race in NEUTRAL_RACES and is_dark:
        return {"regen": -1, "text": "⚠️ Тёмный город"}
    if race in DARK_REGEN_BUFF and is_dark:
        own = DARK_CITIES.get(location) == race
        b = DARK_REGEN_BUFF[race]["own" if own else "other"]
        return {"regen": b, "text": f"🌑 {'Родной' if own else 'Чужой'} тёмный"}
    if near_temple == 1 and not is_dark:
        return {"regen": 1, "text": "⛪ Святая земля"}
    return {}


