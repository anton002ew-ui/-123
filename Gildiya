    px = p.get('player_x', 100) or 100; py = p.get('player_y', 100) or 100
    biome = get_biome_at(px, py)
    pool = get_herbs_for_biome(biome)
    if not pool:
        await interaction.response.send_message(
            f"❌ В {get_biome_name(biome)} трав нет.", ephemeral=True); return
    key = f"last_gather_{interaction.user.id}"
