def _hp_bar(cur, maxv, length=10):
    if maxv <= 0: return "▱" * length
    filled = int(round(length * cur / maxv))
    filled = max(0, min(length, filled))
    if cur / maxv > 0.6:   icon = "🟩"
    elif cur / maxv > 0.3: icon = "🟨"
    else:                  icon = "🟥"
    return icon * filled + "⬛" * (length - filled)

def _mood_emoji(cur, maxv):
    if maxv <= 0: return "⚪"
    r = cur / maxv
    if r > 0.75: return "😊"
    if r > 0.5:  return "😐"
    if r > 0.25: return "😟"
    if r > 0:    return "😰"
    return "💀"


