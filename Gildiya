def create_merchant_stock(mt_key):
    mt = MERCHANT_TYPES.get(mt_key)
    if not mt: return []
    stock = []
    for cat in mt['sells']:
        pool = [iid for iid, it in ITEMS.items() if it.get('cat') == cat]
        if pool:
            picks = random.sample(pool, min(len(pool), random.randint(4, 10)))
            for iid in picks:
                qty = random.randint(1,10) if ITEMS[iid]['cat'] in ("potion","scroll","food","material","herb") else random.randint(1,3)
                stock.append({"item":iid,"count":qty,"quality":random.choices([1,2,3],[0.7,0.25,0.05])[0]})
    return stock


def calc_price(item_id, npc, player, is_sell=False):
    it = ITEMS.get(item_id)
    if not it: return 0
    base = it['price']; markup = npc.get('markup') or 1.0
    reps = json.loads(player.get('reputation') or '{}')
    npc_rep = reps.get(str(npc['id']), 0)
    city = npc.get('home_settlement') or ""
    city_rep = get_city_reputation(player, city)
    total_rep = npc_rep + city_rep // 2
    rep_mod = max(0.6, min(1.8, 1.0 - total_rep * 0.015))
    prof_bonus = total_profession_bonuses(player)
    trade_discount = 1.0 - min(0.20, prof_bonus.get('gold_bonus',0) * 0.005)
    final = base * markup * rep_mod * trade_discount

    # Клейма — только локальные
    try:
        cache = player.get('_brands_cache') or {}
        local_brands = cache.get(city, 0)
    except: local_brands = 0
    if local_brands > 0:
        final *= (1 + local_brands * 0.15)

    if is_sell: final *= 0.4
    return max(1, int(round(final)))


def reputation_title(rep):
    if rep <= -20: return "💀 Враг"
    if rep <= -10: return "😠 Враждебный"
    if rep <= -3:  return "😒 Недовольный"
    if rep <= 0:   return "😐 Нейтральный"
    if rep <= 5:   return "🙂 Знакомый"
    if rep <= 15:  return "😊 Друг"
    if rep <= 30:  return "🤝 Доверенный"
    if rep <= 50:  return "💛 Верный"
    return "🌟 Легендарный"

