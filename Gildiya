        await db.execute("""INSERT INTO crimes
            (player_id, city, kind, description, severity, witnesses, stolen_value, reported)
            VALUES (?,?,?,?,?,?,?,?)""",
            (player_id, city, kind, description, severity, witnesses,
             stolen_value, 1 if reported else 0))
