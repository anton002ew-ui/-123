async def apply_quest_penalty(player_id, amount, reason="штраф"):
    p = await db_get_player(player_id)
    if not p: return None
    gold = p.get('gold', 0) or 0
    report = {"gold_taken":0,"items_taken":[],"change_given":0,
              "remaining_penalty":0,"executed":False}
    if gold >= amount:
        await give_gold(player_id, -amount, reason); report["gold_taken"] = amount; return report
    if gold > 0:
        await give_gold(player_id, -gold, reason); report["gold_taken"] = gold
        remaining = amount - gold
    else:
        remaining = amount
    inv = await get_player_inventory(player_id)
    inv = [i for i in inv if not i.get('equipped_slot')]
    def item_price(inv_item):
        it = ITEMS.get(inv_item['item_id'], {}); return it.get('price', 0) * (1 + (inv_item['quality']-1)*0.3)
    inv.sort(key=item_price, reverse=True)
    change = 0
    for inv_item in inv:
        if remaining <= 0: break
        price = int(item_price(inv_item))
        if price <= 0: continue
        sell_value = price // 2
        await remove_inventory_item(player_id, inv_item['item_id'], 1, inv_item['quality'])
        report["items_taken"].append(f"{inv_item['item_id']} (+{sell_value}💰)")
        remaining -= sell_value
        if remaining < 0:
            change = -remaining
            await give_gold(player_id, change, "сдача")
            report["change_given"] = change; remaining = 0
    report["remaining_penalty"] = max(0, remaining)
    if remaining > 0:
        pp = await db_get_player(player_id)
        await db_save_player({**pp, "gold": -(remaining)})
        if abs(-remaining) >= DEBT_KILL_THRESHOLD:
            await execute_player(player_id, reason=f"Неоплатный долг {remaining}💰")
            report["executed"] = True
    return report


