async def disband_group(interaction, gid):
    g = await db_get_quest_group(gid)
    if not g:
        await interaction.response.send_message("❌ Группа не найдена.", ephemeral=True); return
    if g['leader_id'] != interaction.user.id:
        await interaction.response.send_message("❌ Только лидер.", ephemeral=True); return
    members = json.loads(g['members'] or '[]')
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("DELETE FROM quest_groups WHERE id=?", (gid,)); await db.commit()
    for m in members:
        if m == interaction.user.id: continue
        try:
            u = interaction.client.get_user(m)
            if u: await u.send(f"❌ Группа **{g['name']}** распущена лидером.")
        except: pass
    await interaction.response.send_message("❌ Группа распущена.", ephemeral=True)


