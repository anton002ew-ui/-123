def build_races_page(page=0, pp=5):
    names = list(RACES.keys()); total = (len(names)+pp-1)//pp
    page = max(0, min(page, total-1)); s0 = page*pp; e0 = s0+pp
    embed = discord.Embed(title=f"📖 Расы — стр. {page+1}/{total}",
        description=f"**Всего:** {len(names)} рас.", color=0x805ad5)
    for name in names[s0:e0]:
        s = RACES[name]; d = RACE_DESCRIPTIONS.get(name,"—"); ab = ABILITY_EFFECTS.get(name,{})
        city = START_CITIES.get(name,"—")
        ab_str = f"\n⚡ **{ab.get('name','—')}:** {ab.get('desc','—')}" if ab else ""
        v = (f"*{d}*\n🏘 {city}\n❤️{s['hp']} ⚔️{s['atk']} 🛡{s['def']} 🔮{s['mdef']}\n"
             f"✨{s['mag']} 💨{s['spd']} 🧠{s['intl']}{ab_str}")
        embed.add_field(name=f"🧬 {name}", value=v[:1020], inline=False)
    return embed


